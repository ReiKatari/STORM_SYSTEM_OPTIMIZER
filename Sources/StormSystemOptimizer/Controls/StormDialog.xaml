<ContentDialog
    x:Class="StormSystemOptimizer.Controls.StormDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StormSystemOptimizer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource DialogBgBrush}"
    BorderBrush="{ThemeResource DialogBorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    PrimaryButtonText="Подтвердить"
    CloseButtonText="Отмена"
    DefaultButton="Primary">

    <StackPanel Spacing="12" Padding="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="{ThemeResource AccentGlowBrush}" CornerRadius="6" Padding="6">
                <FontIcon x:Name="DlgIcon" Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource AccentPrimaryBrush}"/>
            </Border>
            <TextBlock x:Name="DlgTitle" Text="Подтверждение действия" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="DlgMessage" Text="Вы уверены, что хотите выполнить данную операцию?"
                   FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</ContentDialog>
