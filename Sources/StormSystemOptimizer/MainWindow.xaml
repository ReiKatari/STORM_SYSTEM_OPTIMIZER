<Window x:Class="StormSystemOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StormSystemOptimizer"
        Icon="Assets/AppIcon.ico" Title="STORM SYSTEM OPTIMIZER 2.1.0"
        Height="920" Width="1520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark TitleBar -->
        <Grid Grid.Row="0" Background="{DynamicResource NavSidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Storm Logo Badge & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border CornerRadius="8" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <Image Source="pack://application:,,,/Assets/app_icon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="STORM" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" SYSTEM OPTIMIZER" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <!-- Version Badge -->
                <Border Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="2.1.0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Center Global Search Box with Live Results Popup -->
            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Height="32" Padding="8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Path Grid.Column="0" Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <!-- Search TextBox -->
                        <TextBox x:Name="TxtGlobalSearch"
                                 Grid.Column="1"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextChanged="TxtGlobalSearch_TextChanged"
                                 KeyDown="TxtGlobalSearch_KeyDown"/>

                        <!-- Watermark Placeholder -->
                        <TextBlock Grid.Column="1"
                                   x:Name="TxtSearchWatermark"
                                   Text="Поиск по разделам, твикам и функциям..."
                                   FontSize="11.5"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- Clear Search Button -->
                        <Button x:Name="BtnClearSearch"
                                Grid.Column="2"
                                Click="BtnClearSearch_Click"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,0">
                            <TextBlock Text="✕" FontSize="11" Foreground="#9CA3AF"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search Results Dropdown Popup -->
                <Popup x:Name="PopupSearchResults"
                       PlacementTarget="{Binding ElementName=TxtGlobalSearch}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Slide">
                    <Border Width="420" MaxHeight="340" Background="#111827" BorderBrush="#0EA5E9" BorderThickness="1.5" CornerRadius="8" Margin="0,6,0,0" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.7"/>
                        </Border.Effect>
                        <ListBox x:Name="ListSearchResults"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ListSearchResults_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Icon -->
                                            <Border Grid.Column="0" Background="#1A00D2FF" CornerRadius="4" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Title & Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="#F9FAFB"/>
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#9CA3AF" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Category Badge -->
                                            <Border Grid.Column="2" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <!-- Header Quick Action Buttons (Check Updates) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Check Updates Button -->
                <Button Click="BtnCheckUpdates_Click"
                        Style="{DynamicResource StormSecondaryButton}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                            <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="TxtHeaderUpdate" Text="Проверить обновления" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Window Control Buttons (Minimize, Maximize, Close) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="BtnMinimize_Click" Width="46" Height="48" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="2"/>
                </Button>
                <Button Click="BtnMaximize_Click" Width="46" Height="48" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10"/>
                </Button>
                <Button Click="BtnClose_Click" Width="48" Height="48" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent">
                                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: Navigation Sidebar + Content Frame -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource NavSidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="10,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ========================================================= -->
                            <!-- 1. БЫСТРЫЙ СТАРТ И МОНИТОРИНГ -->
                            <!-- ========================================================= -->
                            <Expander Style="{DynamicResource StormNavExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Быстрый старт и мониторинг" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton GroupName="NavGroup" IsChecked="True" Tag="QuickMaintenance" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoQuickMaintenance}" Fill="{StaticResource IconGradEmerald}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Быстрое обслуживание" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="Dashboard" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Панель состояния" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="SystemInfo" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoSystemInfo}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Информация о системе" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="Benchmarks" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoBenchmarks}" Fill="{StaticResource IconGradPurple}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Тесты и сенсоры оборудования" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <!-- ========================================================= -->
                            <!-- 2. НАКОПИТЕЛИ И ОЧИСТКА -->
                            <!-- ========================================================= -->
                            <Expander Style="{DynamicResource StormNavExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradSky}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Накопители и очистка" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton GroupName="NavGroup" Tag="Disks" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradSky}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Диски и SMART накопители" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="Scanner" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Глубокая очистка дисков" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="DatabaseOptimizer" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoDatabase}" Fill="{StaticResource IconGradSky}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Оптимизация баз данных SQLite" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="FolderProtection" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoFolderLock}" Fill="{StaticResource IconGradAmber}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Защита личных папок" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <!-- ========================================================= -->
                            <!-- 3. ПРОИЗВОДИТЕЛЬНОСТЬ И ИГРЫ -->
                            <!-- ========================================================= -->
                            <Expander Style="{DynamicResource StormNavExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoGameBoost}" Fill="{StaticResource IconGradRose}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Производительность и игры" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton GroupName="NavGroup" Tag="MemoryMaster" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoPagefile}" Fill="{StaticResource IconGradPurple}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Управление памятью и файлом подкачки" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="Startup" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradAmber}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Управление автозагрузкой" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="BootProfiler" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoTimer}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Время загрузки и автозапуск" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="InputLag" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradRose}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Оптимизация задержки ввода" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="AudioLatency" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoAudio}" Fill="{StaticResource IconGradAmber}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Задержки аудио и MMCSS" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="UsbPolling" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoUsb}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Питание USB и отклик" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="InterruptAffinity" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoInterrupts}" Fill="{StaticResource IconGradRose}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Ядра и прерывания DPC/ISR" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <!-- ========================================================= -->
                            <!-- 4. СЕТЬ И ИНТЕРНЕТ -->
                            <!-- ========================================================= -->
                            <Expander Style="{DynamicResource StormNavExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradEmerald}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Сеть и интернет" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton GroupName="NavGroup" Tag="Network" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Ускорение интернета и DNS" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton GroupName="NavGroup" Tag="SystemTools" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoSystemTools}" Fill="{StaticResource IconGradAmber}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Инструменты и порты ОС" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Expander>

                            <!-- ========================================================= -->
                            <!-- 5. ОБОЛОЧКА, ИНТЕРФЕЙС И ПРИЛОЖЕНИЯ -->
                            <!-- ========================================================= -->
                            <Expander Style="{DynamicResource StormNavExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoVisual}" Fill="{StaticResource IconGradPurple}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Оболочка, интерфейс и приложения" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource NavGroupTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,2,0,4">
                                    <RadioButton GroupName="NavGroup" Tag="VisualPerformance" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
