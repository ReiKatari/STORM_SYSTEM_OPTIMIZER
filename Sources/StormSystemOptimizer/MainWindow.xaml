<Window x:Class="StormSystemOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StormSystemOptimizer"
        Title="STORM SYSTEM OPTIMIZER v0.2.1"
        Height="900" Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark TitleBar -->
        <Grid Grid.Row="0" Background="{DynamicResource NavSidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Storm Logo Badge & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="15" Height="15" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="STORM" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" SYSTEM OPTIMIZER" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v0.2.1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Header Quick Action Buttons (Check Updates) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Check Updates Button -->
                <Button Click="BtnCheckUpdates_Click"
                        Style="{DynamicResource StormSecondaryButton}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                            <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="TxtHeaderUpdate" Text="Проверить обновления" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Window Control Buttons (Minimize, Maximize, Close) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="BtnMinimize_Click" Width="46" Height="48" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Path Data="M 0,0 L 10,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="2"/>
                </Button>
                <Button Click="BtnMaximize_Click" Width="46" Height="48" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10"/>
                </Button>
                <Button Click="BtnClose_Click" Width="48" Height="48" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent">
                                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Body: Navigation Sidebar + Content Frame -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource NavSidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,12,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. Dashboard -->
                            <RadioButton GroupName="NavGroup" IsChecked="True" Tag="Dashboard" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Панель состояния" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. Processes -->
                            <RadioButton GroupName="NavGroup" Tag="Processes" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoProcesses}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Менеджер процессов" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. Disks -->
                            <RadioButton GroupName="NavGroup" Tag="Disks" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Диски и Оптимизация" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. Benchmarks -->
                            <RadioButton GroupName="NavGroup" Tag="Benchmarks" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoBenchmarks}" Fill="{StaticResource IconGradPurple}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Тесты и Стресс-тест" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 5. Scanner -->
                            <RadioButton GroupName="NavGroup" Tag="Scanner" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Глубокое сканирование" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 6. Startup -->
                            <RadioButton GroupName="NavGroup" Tag="Startup" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Автозагрузка" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 7. Services -->
                            <RadioButton GroupName="NavGroup" Tag="Services" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A34D399" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoServices}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Службы Windows" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 8. Network -->
                            <RadioButton GroupName="NavGroup" Tag="Network" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Ускорение интернета" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 9. Privacy -->
                            <RadioButton GroupName="NavGroup" Tag="Privacy" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoPrivacy}" Fill="{StaticResource IconGradRose}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Приватность" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 10. Uninstaller (New) -->
                            <RadioButton GroupName="NavGroup" Tag="Uninstaller" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoUninstaller}" Fill="{StaticResource IconGradRose}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Удаление программ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 11. Folder Protection (New) -->
                            <RadioButton GroupName="NavGroup" Tag="FolderProtection" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoFolderLock}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Скрытие папок" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 12. Drivers (New) -->
                            <RadioButton GroupName="NavGroup" Tag="Drivers" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoDrivers}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Обновление драйверов" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 13. Software Updater (New) -->
                            <RadioButton GroupName="NavGroup" Tag="SoftwareUpdater" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoAppUpdate}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Обновление программ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 14. System Info (New) -->
                            <RadioButton GroupName="NavGroup" Tag="SystemInfo" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoSystemInfo}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Информация о системе" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 15. BIOS Optimizer (New) -->
                            <RadioButton GroupName="NavGroup" Tag="BiosOptimizer" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoBios}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Настройки BIOS" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- 16. System Tools -->
                            <RadioButton GroupName="NavGroup" Tag="SystemTools" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoSystemTools}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Инструменты ОС" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Settings & Themes -->
                    <RadioButton Grid.Row="1" GroupName="NavGroup" Tag="Settings" Click="NavButton_Click" Style="{DynamicResource NavRadioButtonStyle}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource IconGradPurple}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Настройки и Темы" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- Main Content Frame -->
            <Frame x:Name="MainContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
        </Grid>

        <!-- Bottom System Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource NavSidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A34D399" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="10" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="STORM Engine v0.2.1 готов • Система оптимизирована и стабильна" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="100% Безопасная Оптимизация • WPF .NET 8" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
