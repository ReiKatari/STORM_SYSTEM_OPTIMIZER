<Application x:Class="StormSystemOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/StormDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Neon Solid Square CheckBox Style (No checkmarks, pure filled neon square) -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="CheckSquare"
                                        Width="18" Height="18"
                                        CornerRadius="4"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1.5"
                                        VerticalAlignment="Center">
                                    <Border x:Name="InnerFill"
                                            CornerRadius="2"
                                            Margin="2"
                                            Background="Transparent"/>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckSquare" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="InnerFill" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CheckSquare" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CheckSquare" Property="Opacity" Value="0.4"/>
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
