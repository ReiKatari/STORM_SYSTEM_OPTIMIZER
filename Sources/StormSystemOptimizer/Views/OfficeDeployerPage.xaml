<Page x:Class="StormSystemOptimizer.Views.OfficeDeployerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Office Deployer">

    <Page.DataContext>
        <vm:OfficeDeployerViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoOffice}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Центр развертывания и лицензий Microsoft Office" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Выборочная C2R-установка Microsoft Office 2016-2024 / 365 с официальных серверов CDN Microsoft, исключение телеметрии Teams/OneDrive, KMS/GVLK менеджер и глубокая очистка."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <WrapPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Установлено: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding InstalledOfficeInfo}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" TextWrapping="Wrap"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding CheckUpdateCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,4">
                            <TextBlock Text="Проверить обновления" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding TriggerUpdateCommand}" Style="{DynamicResource StormPrimaryButton}" Padding="12,8" Margin="0,0,8,4">
                            <TextBlock Text="Обновить сейчас" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <Button Command="{Binding ForceRemoveCommand}" Style="{DynamicResource StormDangerButton}" Padding="12,8" Margin="0,0,0,4">
                            <TextBlock Text="Зачистка (Force)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Configuration & Actions Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Edition & Components Config -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="1. Выбор редакции и параметров" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <!-- Edition Selector -->
                        <TextBlock Text="Редакция пакета Microsoft Office:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Editions}" SelectedItem="{Binding SelectedEdition}" DisplayMemberPath="DisplayName" Margin="0,0,0,8" Height="34"/>

                        <!-- CDN Server Selector -->
                        <TextBlock Text="Сервер загрузки и репозиторий CDN:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CdnServers}" SelectedItem="{Binding SelectedCdnServer}" DisplayMemberPath="DisplayName" Margin="0,0,0,8" Height="34"/>

                        <!-- Edition Version & Desc Banner -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedEditionVersionText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedEditionDesc}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedCdnServer.Description, StringFormat='Сервер CDN: {0}'}" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Architecture & Language -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Разрядность:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding SelectedArchitecture}" SelectedValuePath="Tag" Height="32">
                                    <ComboBoxItem Content="64-бит (x64) [Рекомендуется]" Tag="64" IsSelected="True"/>
                                    <ComboBoxItem Content="32-бит (x86)" Tag="32"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Языковой пакет:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag" Height="32">
                                    <ComboBoxItem Content="Русский (ru-RU)" Tag="ru-ru" IsSelected="True"/>
                                    <ComboBoxItem Content="English (en-US)" Tag="en-us"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2. Выбор приложений для установки" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding SelectAllAppsCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="8,4" Margin="0,0,6,0">
                                    <TextBlock Text="Все" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                                <Button Command="{Binding SelectBasicAppsCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="8,4">
                                    <TextBlock Text="Базовые" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Applications Checkbox Matrix -->
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <CheckBox Content="Word" IsChecked="{Binding InstallWord}" Margin="0,0,0,8"/>
                            <CheckBox Content="Excel" IsChecked="{Binding InstallExcel}" Margin="0,0,0,8"/>
                            <CheckBox Content="PowerPoint" IsChecked="{Binding InstallPowerPoint}" Margin="0,0,0,8"/>
                            <CheckBox Content="Access" IsChecked="{Binding InstallAccess}" Margin="0,0,0,8"/>
                            <CheckBox Content="Outlook" IsChecked="{Binding InstallOutlook}" Margin="0,0,0,8"/>
                            <CheckBox Content="OneNote" IsChecked="{Binding InstallOneNote}" Margin="0,0,0,8"/>
                            <CheckBox Content="Publisher" IsChecked="{Binding InstallPublisher}" Margin="0,0,0,8"/>
                            <CheckBox Content="Visio Pro" IsChecked="{Binding InstallVisio}" Margin="0,0,0,8"/>
                            <CheckBox Content="Project Pro" IsChecked="{Binding InstallProject}" Margin="0,0,0,8"/>
                        </UniformGrid>

                        <TextBlock Text="3. Исключение мусора и телеметрии" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,8"/>
                        <StackPanel Margin="0,0,0,16">
                            <CheckBox Content="Исключить Microsoft Teams (автозагрузка и фон)" IsChecked="{Binding ExcludeTeams}" Margin="0,0,0,6"/>
                            <CheckBox Content="Исключить OneDrive и синхронизацию" IsChecked="{Binding ExcludeOneDrive}" Margin="0,0,0,6"/>
                            <CheckBox Content="Исключить Bing Search и телеметрию поиска" IsChecked="{Binding ExcludeBing}"/>
                        </StackPanel>

                        <!-- Main Install Button -->
                        <Button Command="{Binding InstallCommand}" Style="{DynamicResource StormHeroButton}" Padding="16,10" MinHeight="44">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GeoOffice}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="СКАЧАТЬ И УСТАНОВИТЬ MICROSOFT OFFICE" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Column: KMS & License Hub + Live Log -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="4. Активация и управление лицензиями" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Онлайн KMS-сервер:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding KmsServers}" SelectedItem="{Binding SelectedKmsServer}" Height="32" Margin="0,0,0,12"/>

                        <CheckBox Content="Автоматически активировать после установки" IsChecked="{Binding AutoActivate}" Margin="0,0,0,12"/>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Button Command="{Binding ActivateCommand}" Style="{DynamicResource StormHeroButton}" Padding="10,8" Margin="0,0,6,0">
                                <TextBlock Text="Активировать KMS" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                            </Button>
                            <Button Command="{Binding CleanKeysCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="10,8" Margin="6,0,0,0">
                                <TextBlock Text="Очистить ключи" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </UniformGrid>

                        <TextBlock Text="Лог выполнения и консоль" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,8"/>
                        <Border Background="#0D1117" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Height="250" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding StatusLog}" FontFamily="Consolas" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
