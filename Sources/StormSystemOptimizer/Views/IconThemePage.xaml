<Page x:Class="StormSystemOptimizer.Views.IconThemePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="950" d:DesignWidth="1100"
      Title="Темы значков системы">

    <Page.DataContext>
        <vm:IconThemeViewModel/>
    </Page.DataContext>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">
                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Темы значков системы" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Настоящая замена значков Windows: фирменные Shell-пакеты, папки, диски, корзина и каталог из 320 векторных значков"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshAppliedThemeStatusCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,10,0">
                            <TextBlock Text="Обновить статус" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding RebuildIconCacheCommand}" Style="{StaticResource StormHeroButton}" Padding="16,8">
                            <TextBlock Text="⚡ Сбросить кэш значков" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Custom Icon Package (ZIP / 7TSP / ICO) Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Установка стороннего пакета значков (ZIP, 7tsp, IconPack)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <TextBox Text="{Binding CustomPackagePath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <Button Grid.Column="1" Command="{Binding BrowseCustomPackageCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                                <TextBlock Text="Обзор..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding InstallCustomPackageCommand}" Style="{StaticResource StormHeroButton}" Padding="16,8">
                                <TextBlock Text="Установить пакет" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Individual Icon Replacement Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Индивидуальная замена значков системы" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Target Selector -->
                            <ComboBox Grid.Column="0" ItemsSource="{Binding TargetLocations}" SelectedItem="{Binding SelectedCustomTarget}" Height="36" Margin="0,0,8,0"/>

                            <!-- File Path -->
                            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <TextBox Text="{Binding CustomIconFilePath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <!-- Browse Button -->
                            <Button Grid.Column="2" Command="{Binding BrowseCustomIconFileCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                                <TextBlock Text="Обзор..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>

                            <!-- Apply Button -->
                            <Button Grid.Column="3" Command="{Binding ApplyCustomSingleIconCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8">
                                <TextBlock Text="Применить" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Curated Icon Themes Grid -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Проверенные темы значков системы" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding IconThemes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Preview Icon Badge -->
                                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00D2FF" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                                                </Border.Effect>
                                                <Path Data="{Binding PreviewGeometryKey, Converter={StaticResource StringToGeometryConverter}}" Fill="{StaticResource IconGradCyan}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border Background="#1A00D2FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                    </Border>
                                                    <Border Visibility="{Binding IsApplied, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Активна в системе" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Background="#1A00D2FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Author, StringFormat='Стиль: {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompatibilityBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            </Border>

                                            <Border Grid.Column="3" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.OpenCatalogPreviewCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        Style="{StaticResource StormSecondaryButton}"
                                                        Padding="12,8" Margin="0,0,8,0">
                                                    <TextBlock Text="Каталог значков" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StormHeroButton}"
                                                        Padding="16,8">
                                                    <TextBlock Text="Применить" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Каталог STORM Cyber Glow и панель действий -->
                <Border Visibility="{Binding IsCatalogPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoFolder}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Интерактивный каталог значков (320 векторных значков)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Кликните по любому значку, чтобы применить его к папке на ПК, к ярлыку, назначить системным или экспортировать в .ico." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CloseCatalogPreviewCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="✕ Закрыть" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Категории фильтрации и строка поиска -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <!-- Categories -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding CatalogCategories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.FilterCatalogCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="10,5" Margin="0,0,6,4"
                                                FontSize="11" FontWeight="Bold"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Search -->
                            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Batch Actions Bar -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Выбрано значков: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button Command="{Binding SelectAllCatalogIconsCommand}" CommandParameter="True" Style="{StaticResource StormSecondaryButton}" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="Выбрать все" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding SelectAllCatalogIconsCommand}" CommandParameter="False" Style="{StaticResource StormSecondaryButton}" Padding="10,4">
                                        <TextBlock Text="Снять выбор" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding ApplySelectedCatalogIconsCommand}" Style="{StaticResource StormHeroButton}" Padding="14,6">
                                    <TextBlock Text="⚡ Применить выбранные значки" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Icons UniformGrid / List -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" MaxHeight="400">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredCatalogIcons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenIconActionDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Нажмите для действий с этим значком (применить к папке, ярлыку, экспортировать)">
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Path Data="{Binding GeometryKey, Converter={StaticResource StringToGeometryConverter}}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Status Banner -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <TextBlock Text="{Binding StatusMessage, StringFormat='💡 Статус: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Icon Detail / Action Modal Dialog Overlay -->
        <Grid Visibility="{Binding IsIconDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#E60A0B10" Panel.ZIndex="100">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"
                    BorderThickness="1.5" CornerRadius="16" Margin="40" MaxWidth="620"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="8" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{Binding SelectedIconDetail.GeometryKey, Converter={StaticResource StringToGeometryConverter}}" Fill="{StaticResource IconGradCyan}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedIconDetail.Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SelectedIconDetail.Category, StringFormat='Категория: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseIconActionDialogCommand}" Style="{StaticResource StormSecondaryButton}" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock Text="✕ Закрыть" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Large 3D Icon Preview Box -->
                    <Border Background="#0D1117" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18" HorizontalAlignment="Center" Width="140" Height="140">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D2FF" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.4"/>
                        </Border.Effect>
                        <Path Data="{Binding SelectedIconDetail.GeometryKey, Converter={StaticResource StringToGeometryConverter}}" Fill="{StaticResource IconGradCyan}" Width="68" Height="68" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Actions List -->
                    <TextBlock Text="Выберите действие для этого значка:" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <!-- Action 1: Apply to Folder -->
                    <Button Command="{Binding ApplyDetailIconToFolderCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📁 " FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Применить к любой папке на ПК..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Выбрать целевую папку и назначить значок через desktop.ini" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Action 2: Apply to Shortcut -->
                    <Button Command="{Binding ApplyDetailIconToShortcutCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔗 " FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Применить к ярлыку (.lnk)..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Выбрать ярлык на рабочем столе и обновить его иконку" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Action 3: Assign as System Icon -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ApplyDetailIconAsSystemCommand}" CommandParameter="Folders" Style="{StaticResource StormSecondaryButton}" Padding="10,8">
                            <TextBlock Text="💻 Как папка" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ApplyDetailIconAsSystemCommand}" CommandParameter="ThisPC" Style="{StaticResource StormSecondaryButton}" Padding="10,8">
                            <TextBlock Text="💻 Этот компьютер" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Grid.Column="4" Command="{Binding ApplyDetailIconAsSystemCommand}" CommandParameter="Drives" Style="{StaticResource StormSecondaryButton}" Padding="10,8">
                            <TextBlock Text="💻 Диск системы" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Экспорт ICO и копирование PNG -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ExportDetailIconAsIcoCommand}" Style="{StaticResource StormHeroButton}" Padding="12,10">
                            <TextBlock Text="💾 Экспортировать .ico..." FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding CopyDetailIconToClipboardCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,10">
                            <TextBlock Text="📋 Копировать PNG" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
