<Page x:Class="StormSystemOptimizer.Views.IconThemePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Темы значков системы">

    <Page.DataContext>
        <vm:IconThemeViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoApps}" Fill="{StaticResource IconGradPurple}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Темы системных значков и кэш Проводника" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Поддержка пакетов IconPackager, 7tsp, iPack, полная замена значков папок и дисков, мгновенная очистка кэша значков в 1 клик."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RebuildIconCacheCommand}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,8,4">
                            <TextBlock Text="Очистить кэш значков (1 клик)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <Button Command="{Binding ResetIconsToDefaultCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,0,4">
                            <TextBlock Text="Сбросить на стандартные" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Install Icon Pack Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Установка стороннего пакета значков (7tsp, IconPackager, iPack, ZIP)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Выберите архив со значками (.iconpack, .ip, .7tsp, .zip или .ico). STORM автоматически распакует и свяжет значки с системными библиотеками." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <TextBox Text="{Binding CustomPackagePath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <Button Grid.Column="1" Command="{Binding BrowseIconPackageCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Выбрать архив..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding InstallPackageCommand}" Style="{StaticResource StormHeroButton}" Padding="16,8">
                            <TextBlock Text="Установить тему" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Custom Single Icon Customizer Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Индивидуальная замена значков системы" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Target Selector -->
                        <ComboBox Grid.Column="0" ItemsSource="{Binding TargetLocations}" SelectedItem="{Binding SelectedCustomTarget}" Height="36" Margin="0,0,8,0"/>

                        <!-- File Path -->
                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <TextBox Text="{Binding CustomIconFilePath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <!-- Browse Button -->
                        <Button Grid.Column="2" Command="{Binding BrowseCustomIconFileCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Обзор..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>

                        <!-- Apply Button -->
                        <Button Grid.Column="3" Command="{Binding ApplyCustomIconCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8">
                            <TextBlock Text="Применить" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Curated Icon Themes Grid -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Проверенные темы значков системы" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding IconThemes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Preview Icon Badge -->
                                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00D2FF" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Path Data="{Binding PreviewGeometryKey, Converter={StaticResource StringToGeometryConverter}}" Fill="{StaticResource IconGradCyan}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border Background="#1A00D2FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                </Border>
                                                <Border Visibility="{Binding IsApplied, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Активна в системе" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Border Background="#26F59E0B" BorderBrush="#4DF59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="★ " Foreground="#F59E0B" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Rating, StringFormat='{}{0:F1}'}" Foreground="#F59E0B" FontSize="11" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#1A64748B" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding DownloadsCount, StringFormat='{}{0:N0} загрузок'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Author, StringFormat='Автор: {0}'}" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompatibilityBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        </Border>

                                        <Border Grid.Column="3" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.OpenCatalogPreviewCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="12,8" Margin="0,0,8,0">
                                                <TextBlock Text="Каталог значков" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormHeroButton}"
                                                    Padding="16,8">
                                                <TextBlock Text="Применить" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Real STORM Cyber Glow Catalog & Selective Apply Card -->
            <Border Visibility="{Binding IsCatalogPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoApps}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Каталог значков STORM Cyber Glow (320 значков)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Выбирайте отдельные значки или целые категории для выборочного частичного применения в системе." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding CloseCatalogPreviewCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="✕ Закрыть" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Filter Categories & Search Bar -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Categories -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding CatalogCategories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.FilterCatalogCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            Style="{StaticResource StormSecondaryButton}"
                                            Padding="10,5" Margin="0,0,6,4"
                                            FontSize="11" FontWeight="Bold"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Search -->
                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Select All / Unselect Bar & Counters -->
                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SelectAllCatalogIconsCommand}" CommandParameter="True" Style="{StaticResource StormSecondaryButton}" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Text="Выбрать все" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </Button>
                                <Button Command="{Binding SelectAllCatalogIconsCommand}" CommandParameter="False" Style="{StaticResource StormSecondaryButton}" Padding="10,4">
                                    <TextBlock Text="Снять выбор" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding SelectedCount, StringFormat='Отмечено для установки: {0} из 320 значков'}"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <Button Grid.Column="2" Command="{Binding ApplySelectedIconsCommand}" Style="{StaticResource StormHeroButton}" Padding="16,6">
                                <TextBlock Text="{Binding SelectedCount, StringFormat='Применить выбранные ({0})'}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Icons UniformGrid / List -->
                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" MaxHeight="380">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredCatalogIcons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Path Data="{Binding GeometryKey, Converter={StaticResource StringToGeometryConverter}}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <TextBlock Text="{Binding StatusMessage, StringFormat='💡 Статус: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
