<Page x:Class="StormSystemOptimizer.Views.DriverUpdaterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Обновление драйверов">

    <Page.DataContext>
        <vm:DriverUpdaterViewModel/>
    </Page.DataContext>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="20,20,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoDevice}" Fill="{StaticResource IconGradSky}" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Центр обновления драйверов" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Проверка актуальности драйверов видеокарты, сети, чипсета и звука. Резервное копирование и безопасная установка с созданием точек восстановления."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatsSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleUsbWriterCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoUsb}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Записать BIOS на USB" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CreateSystemRestorePointCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoShield}" Fill="{StaticResource AccentPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Создать бэкап" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackupAllDriversCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradSky}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Экспорт драйверов" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadDriversCommand}" Style="{StaticResource StormHeroButton}" Padding="14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoScanner}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Сканировать" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- USB BIOS Flash Writer Modal Card (when opened) -->
        <Border Grid.Row="1" Visibility="{Binding IsUsbWriterOpen, Converter={StaticResource BoolToVisConverter}}"
                Background="{DynamicResource NavSidebarBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5"
                CornerRadius="12" Padding="18" Margin="20,0,20,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoUsb}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Мастер записи файла обновления BIOS на USB-флешку (FAT32)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Command="{Binding ToggleUsbWriterCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. Выберите подключенный USB-накопитель:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UsbFlashDrives}" SelectedItem="{Binding SelectedUsbDrive}" DisplayMemberPath="DisplayText"
                                  Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="34" Padding="8,4"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                        <Button Command="{Binding RefreshUsbDrivesCommand}" Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,0">
                            <TextBlock Text="Обновить список" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding FormatUsbFat32Command}" Style="{StaticResource StormSecondaryButton}" Padding="10,6">
                            <TextBlock Text="Форматировать в FAT32" FontSize="11.5" FontWeight="Bold" Foreground="#EF4444"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="2. Файл прошивки BIOS (.CAP, .ROM, .BIN или .ZIP):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding SelectedBiosFilePath}" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}" Height="34" Padding="8,6" FontSize="12"/>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding BrowseBiosFileCommand}" Style="{StaticResource StormSecondaryButton}" VerticalAlignment="Bottom" Padding="12,7" Margin="8,0,0,0">
                        <TextBlock Text="Обзор..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding WriteBiosToUsbCommand}" Style="{StaticResource StormHeroButton}" VerticalAlignment="Bottom" Padding="16,8" Margin="8,0,0,0">
                        <TextBlock Text="Записать на флешку" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Button>
                </Grid>

                <!-- Status Text -->
                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <TextBlock Text="{Binding UsbWriterStatus}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Categories Filter Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Все устройства" IsChecked="True" Style="{StaticResource NavRadioButtonStyle}" Click="CatAll_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="BIOS и прошивка" Style="{StaticResource NavRadioButtonStyle}" Click="CatBios_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Видеокарта" Style="{StaticResource NavRadioButtonStyle}" Click="CatGpu_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Процессор" Style="{StaticResource NavRadioButtonStyle}" Click="CatCpu_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Материнская плата" Style="{StaticResource NavRadioButtonStyle}" Click="CatMobo_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Сеть и Wi-Fi" Style="{StaticResource NavRadioButtonStyle}" Click="CatNet_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Звук" Style="{StaticResource NavRadioButtonStyle}" Click="CatAudio_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Накопители" Style="{StaticResource NavRadioButtonStyle}" Click="CatDisk_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Чипсет и USB" Style="{StaticResource NavRadioButtonStyle}" Click="CatChipset_Click" Margin="0,0,6,4" Padding="10,5"/>
                <RadioButton Content="Бэкапы и точки восстановления" Style="{StaticResource NavRadioButtonStyle}" Click="CatBackups_Click" Margin="0,0,6,4" Padding="10,5"/>
            </WrapPanel>
        </Border>

        <!-- Main Content Area: Drivers List or Backups List -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="20,0,20,12">
            <Grid>
                <!-- Drivers list (When not on Backups tab) -->
                <ScrollViewer Visibility="{Binding IsBackupsSelected, Converter={StaticResource InverseBoolToVisConverter}}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DisplayDrivers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Device Name & Provider -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding DeviceName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ProviderName, StringFormat='{}Поставщик: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Installed Version & Date -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CurrentVersion, StringFormat='{}Установлен: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DriverDate, StringFormat='{}Дата релиза: {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Latest Version -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding LatestVersion, StringFormat='{}Доступен: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text="Сертификация WHQL" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Action Button or Locked Actual Badge -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <!-- When Update Available -->
                                            <Button Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}"
                                                    Command="{Binding DataContext.UpdateDriverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormHeroButton}"
                                                    Padding="14,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoAppUpdate}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Обновить" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- When Driver is Up to Date -->
                                            <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource InverseBoolToVisConverter}}"
                                                    Background="#2610B981"
                                                    BorderBrush="#10B981"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14,8"
                                                    ToolTip="Установлен актуальный сертифицированный драйвер WHQL">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource GeoCheck}" Fill="#10B981" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Актуален" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Backups & Restore Points list (When on Backups tab) -->
                <ScrollViewer Visibility="{Binding IsBackupsSelected, Converter={StaticResource BoolToVisConverter}}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DisplayBackups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Backup Name & Type -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding BackupType}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- Date & Time -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding DateString, StringFormat='{}Создан: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Хранилище STORM" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Size / Driver Count -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding SizeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Готов к откату" FontSize="10.5" Foreground="#10B981" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0"
                                                    ToolTip="Открыть папку с резервной копией">
                                                <TextBlock Text="Папка" FontSize="11" FontWeight="Bold"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.RestoreBackupItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormHeroButton}"
                                                    Padding="12,6">
                                                <TextBlock Text="Восстановить" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Animated Loading Overlay -->
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                      Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource StormCircularLoadingSpinner}" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Проверка цифровых подписей WHQL и версий оборудования..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="100% Безопасное обновление • Официальные WHQL источники" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
