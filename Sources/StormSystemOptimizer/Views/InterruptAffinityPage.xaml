<Page x:Class="StormSystemOptimizer.Views.InterruptAffinityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Interrupt Affinity">

    <Page.DataContext>
        <vm:InterruptAffinityViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoInterrupts}" Fill="{StaticResource IconGradRose}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Диспетчер прерываний DPC/ISR и привязка ядер CPU" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Изоляция прерываний видеокарты, сетевого адаптера и USB-контроллеров по отдельным ядрам процессора для устранения DPC-задержек и микрофризов."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ApplyEsportsPresetCommand}" Style="{DynamicResource StormHeroButton}" Padding="14,10" Margin="0,0,8,0">
                            <TextBlock Text="⚡ КИБЕРСПОРТИВНЫЙ ПРОФИЛЬ" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <Button Command="{Binding ApplyBalancedMsiPresetCommand}" Style="{DynamicResource StormPrimaryButton}" Padding="12,10" Margin="0,0,8,0">
                            <TextBlock Text="🛡️ MSI ДЛЯ ВСЕХ" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <Button Command="{Binding ResetDefaultsCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="12,10">
                            <TextBlock Text="Сброс на Windows" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics Summary Grid -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="ОБНАРУЖЕНО АППАРАТНЫХ PCI УСТРОЙСТВ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalDevicesCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="УСТРОЙСТВ В РЕЖИМЕ MSI (MESSAGE SIGNALED)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalMsiEnabledCount}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Devices Table Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Аппаратные устройства и текущая маршрутизация прерываний" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="10,6">
                            <TextBlock Text="🔄 Обновить список" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="320">
                        <DataGrid ItemsSource="{Binding Devices}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  RowBackground="Transparent"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  SelectedItem="{Binding SelectedDevice}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                                <DataGridTextColumn Header="Устройство" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Статус MSI / Маска" Binding="{Binding StatusSummary}" Width="1.4*"/>
                                <DataGridTextColumn Header="Рекомендация STORM" Binding="{Binding Recommendation}" Width="2*"/>
                                <DataGridTemplateColumn Header="Управление MSI" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleDeviceMsiCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource StormSecondaryButton}"
                                                    Padding="8,4" Margin="2">
                                                <TextBlock Text="{Binding MsiEnabled, Converter={StaticResource BoolToContextMenuTextConverter}, FallbackValue='MSI Mode'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- USB IMOD & QoS Section Grid -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- XHCI IMOD Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoUsb}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Модерация прерываний USB (XHCI IMOD)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Управляет задержкой накопления прерываний USB. Значение 0 отключает задержку для мгновенной реакции игровых мышей с частотой 1000, 4000 или 8000 Гц."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="0" Maximum="1000" Value="{Binding CurrentImodInterval}" SmallChange="50" LargeChange="100" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentImodInterval, StringFormat='{}{0} мкс'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Button Command="{Binding ApplyImodCommand}" Style="{DynamicResource StormHeroButton}" Height="36">
                            <TextBlock Text="⚡ ПРИМЕНИТЬ ИНТЕРВАЛ IMOD" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- QoS DSCP 46 Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Приоритизация пакетов QoS (DSCP 46)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Помечает пакеты соревновательных игр (CS2, Valorant, Apex, Dota2, PUBG, Rust, Fortnite, Warzone) тегом Expedited Forwarding для мгновенной отправки сетевым стеком."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Button Command="{Binding ApplyQosCommand}" Style="{DynamicResource StormHeroButton}" Height="36">
                            <TextBlock Text="🚀 АКТИВИРОВАТЬ QOS DSCP 46 ДЛЯ ВСЕХ ИГР" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
