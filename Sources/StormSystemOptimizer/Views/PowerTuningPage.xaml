<Page x:Class="StormSystemOptimizer.Views.PowerTuningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Power Tuning">

    <Page.DataContext>
        <vm:PowerTuningViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoPower}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Тюнинг питания и ядер процессора" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Управление фирменными схемами энергопитания, отключение парковки ядер CPU и задержек переключения состояний C-States для максимальной плавности в играх."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Текущая схема: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ActiveSchemeName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ActivateStormUltimatePlanCommand}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,10,0">
                            <TextBlock Text="Активировать STORM ULTIMATE PLAN" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <Button Command="{Binding ActivateBalancedPlanCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,10">
                            <TextBlock Text="Сбалансированный" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tweak Cards Grid -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- Card 1: Core Parking -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoCpu}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Отключение парковки ядер (Core Parking)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Запрещает Windows усыплять ядра процессора в микро-паузах, что гарантирует 100% готовность всех потоков и устраняет фризы 1% и 0.1% Low FPS."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1A00D2FF" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CoreParkingStatus}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding CoreParkingBadgeColor}"/>
                        </Border>

                        <Button Command="{Binding ApplyCoreParkingTweaksCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" HorizontalAlignment="Left">
                            <TextBlock Text="Отключить парковку ядер" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 2: C-States & Throttle -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Отключение задержек C-States" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Переводит процессор в режим постоянной базовой и буст-частоты, исключая время на пробуждение транзисторов из глубокого энергосбережения."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1A10B981" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CStatesStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>

                        <Button Command="{Binding ApplyCStatesTweaksCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" HorizontalAlignment="Left">
                            <TextBlock Text="Оптимизировать задержки C-States" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 3: Energy Performance Preference (EPP 0%) -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoPower}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Energy Performance Preference (EPP = 0%)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Задает приоритет максимальной производительности для Intel Speed Shift и AMD CPPC2, ликвидируя время на раскачку частоты ядер под нагрузкой."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1AFBBF24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding EppStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#F59E0B"/>
                        </Border>

                        <Button Command="{Binding ApplyEppTweaksCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" HorizontalAlignment="Left">
                            <TextBlock Text="Задать EPP = 0% (Speed Shift)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 4: Heterogeneous P-Core & PCIe ASPM -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoCpu}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Приоритет P-Cores и PCIe ASPM" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Принудительно направляет потоки активных 3D-игр на производительные P-ядра / лучший CCD и запрещает шине PCIe переходить в экономичный сон."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1AC084FC" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding HeteroStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#C084FC"/>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ApplyHeteroSchedulingCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                                <TextBlock Text="🎯 Приоритет P-Cores" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Command="{Binding ApplyPcieAspmCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,8">
                                <TextBlock Text="🏎️ Отключить ASPM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 5: Multimedia & System Responsiveness -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A06B6D4" BorderBrush="#3306B6D4" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoGamepad}" Fill="{StaticResource IconGradSky}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Снятие троттлинга Windows (Responsiveness 0%)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Отключает 20% резервирование CPU для фоновых задач Windows и снимает сетевой троттлинг сетевых пакетов в играх (NetworkThrottlingIndex)."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1A06B6D4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SystemResponsivenessStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#06B6D4"/>
                        </Border>

                        <Button Command="{Binding ApplySystemResponsivenessCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" HorizontalAlignment="Left">
                            <TextBlock Text="🎮 Снять троттлинг Windows" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 6: GPU Energy Management & HAGS -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoMonitor}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="GPU Maximum Performance and HAGS" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Принудительно форсирует профиль максимальной мощности графического адаптера, активирует планирование HAGS и увеличивает тайм-аут TDR видеодрайвера."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1A10B981" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding GpuPowerStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>

                        <Button Command="{Binding ApplyGpuMaxPerformanceCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" HorizontalAlignment="Left">
                            <TextBlock Text="Форсировать GPU Max Performance" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 7: USB Selective Suspend -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoUsb}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Отключение USB Selective Suspend" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Запрещает контроллерам USB переводить мыши, клавиатуры и звуковые интерфейсы в энергосберегающий микро-сон, снижая задержку ввода до минимума."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1AFB7185" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding UsbSuspendStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#FB7185"/>
                        </Border>

                        <Button Command="{Binding ApplyUsbSelectiveSuspendCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" HorizontalAlignment="Left">
                            <TextBlock Text="🖱️ Отключить микро-сон USB" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 8: Unlock Hidden Power Attributes -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoLock}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Разблокировка 40+ скрытых параметров" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Делает видимыми все скрытые системные настройки питания ядра Windows (Processor Boost, Autonomous Mode, C-State limits) в powercfg и Панели управления."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Border Background="#1AFBBF24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding HiddenAttributesStatus}" FontSize="11.5" FontWeight="Bold" Foreground="#F59E0B"/>
                        </Border>

                        <Button Command="{Binding UnlockHiddenAttributesCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" HorizontalAlignment="Left">
                            <TextBlock Text="🔓 Разблокировать параметры Powercfg" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Status Banner -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <TextBlock Text="{Binding StatusMessage, StringFormat='💡 Статус: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
