<Page x:Class="StormSystemOptimizer.Views.SecurityAuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Безопасность и аудит">

    <Page.DataContext>
        <vm:SecurityAuditViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSecurityAudit}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Центр безопасности, аудита и гарантированного удаления" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Сканирование скрытых криптомайнеров и инжектов автозагрузки, аудит и зачистка сиротских правил Брандмауэра и безвозвратный шредер файлов (DoD 5220.22-M)."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ScanThreatsCommand}" Style="{DynamicResource StormHeroButton}" Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoShield}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Сканировать систему" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics Summary Grid -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Обнаружено угроз и аномалий" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TotalThreatsCount}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Правил брандмауэра Windows" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FirewallRulesCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Сиротских правил к удалению" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding OrphanedRulesCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Threats Section -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Обнаруженные угрозы и аномалии (Майнеры, HOSTS, WMI, Автозагрузка)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding Threats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#1AEF4444" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoDefender}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#EF4444" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TargetPath}" FontSize="10.5" Foreground="#6B7280" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Command="{Binding DataContext.ResolveThreatCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{DynamicResource StormDangerButton}" Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock Text="Устранить" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Угроз и скрытых майнеров не обнаружено. Система чиста и безопасна." FontSize="13" Foreground="#10B981" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Threats.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Firewall Audit & File Shredder Grid -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- Firewall Audit Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoFirewall}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Аудит Брандмауэра Windows" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Поиск и удаление сиротских правил от удаленных программ, засоряющих стек сетевых фильтров Windows Defender Firewall."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <UniformGrid Columns="2">
                            <Button Command="{Binding ScanFirewallCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="10,8" Margin="0,0,6,0">
                                <TextBlock Text="🔄 Анализ правил" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Command="{Binding PurgeOrphanedFirewallCommand}" Style="{DynamicResource StormHeroButton}" Padding="10,8" Margin="6,0,0,0">
                                <TextBlock Text="🧹 Очистить сиротские" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- File Shredder & Free Space Wiper Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoShredder}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Шредер данных и затирание дисков" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Гарантированное уничтожение файлов, целых папок и затирание свободного места (DoD 5220.22-M и Peter Gutmann 35 проходов)."
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <!-- File destruction row -->
                        <TextBlock Text="Уничтожение отдельного файла:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBox Text="{Binding ShredFilePath, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding BrowseShredFileCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="8,5" Margin="6,0,0,0">
                                <TextBlock Text="📁 Файл..." FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ShredFileCommand}" Style="{DynamicResource StormHeroButton}" Padding="10,5" Margin="6,0,0,0">
                                <TextBlock Text="Уничтожить" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>

                        <!-- Folder destruction row -->
                        <TextBlock Text="Рекурсивное уничтожение папки:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBox Text="{Binding ShredFolderPath, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding BrowseShredFolderCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="8,5" Margin="6,0,0,0">
                                <TextBlock Text="📂 Папка..." FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding ShredFolderCommand}" Style="{DynamicResource StormHeroButton}" Padding="10,5" Margin="6,0,0,0">
                                <TextBlock Text="Уничтожить папку" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>

                        <!-- Free Space Wipe row -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Затирание свободного места" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Уничтожение следов удалённых файлов в кластерах" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding SelectedDrive}" Width="65" Height="28" Margin="8,0" VerticalAlignment="Center" FontSize="11"/>
                                <Button Grid.Column="2" Command="{Binding WipeFreeSpaceCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock Text="Очистить диск" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Progress Bar (Only visible during active shredding) -->
                        <Border Visibility="{Binding IsShredding, Converter={StaticResource BoolToVisConverter}}"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Прогресс уничтожения данных:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ShredProgress, StringFormat='{}{0:F0}%'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding ShredProgress}" Maximum="100" Height="5" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
