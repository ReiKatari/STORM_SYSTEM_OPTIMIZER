<Page x:Class="StormSystemOptimizer.Views.SecurityAuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Security &amp; Audit">

    <Page.DataContext>
        <vm:SecurityAuditViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSecurityAudit}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Центр безопасности, аудита и гарантированного удаления" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Сканирование скрытых криптомайнеров и инжектов автозагрузки, аудит и зачистка сиротских правил Брандмауэра и безвозвратный шредер файлов (DoD 5220.22-M)."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ScanThreatsCommand}" Style="{DynamicResource StormHeroButton}" Padding="14,10" Margin="0,0,8,0">
                            <TextBlock Text="🛡️ СКАНИРОВАТЬ СИСТЕМУ" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Threats Section -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Обнаруженные угрозы и аномалии (Майнеры, HOSTS, WMI)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding Threats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#1AEF4444" CornerRadius="6" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoDefender}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding TargetPath}" FontSize="10.5" Foreground="#6B7280" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Command="{Binding DataContext.ResolveThreatCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{DynamicResource StormPrimaryButton}" Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="Устранить" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Угроз не обнаружено. Система чиста." FontSize="13" Foreground="#10B981" FontWeight="SemiBold" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Threats.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Firewall Audit & File Shredder Grid -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- Firewall Audit Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoFirewall}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Аудит Брандмауэра Windows" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Поиск и удаление сиротских правил от удаленных программ, засоряющих стек сетевых фильтров Windows Defender Firewall."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <UniformGrid Columns="2">
                            <Button Command="{Binding ScanFirewallCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="10,8" Margin="0,0,6,0">
                                <TextBlock Text="Анализ правил" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Command="{Binding PurgeOrphanedFirewallCommand}" Style="{DynamicResource StormPrimaryButton}" Padding="10,8" Margin="6,0,0,0">
                                <TextBlock Text="Очистить сиротские" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- File Shredder Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoShredder}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Безвозвратный шредер файлов (DoD 5220)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Многопроходная перезапись байтов случайными данными перед удалением, исключающая восстановление криминалистическим ПО."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ShredFilePath, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="11" VerticalContentAlignment="Center" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                            <Button Grid.Column="1" Command="{Binding BrowseShredFileCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="8,4" Margin="6,0,0,0">
                                <TextBlock Text="Обзор..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>

                        <Button Command="{Binding ShredFileCommand}" Style="{DynamicResource StormHeroButton}" Height="34">
                            <TextBlock Text="🗑️ УНИЧТОЖИТЬ ФАЙЛ БЕЗ ВОЗВРАТА" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
