<Page x:Class="StormSystemOptimizer.Views.TaskSchedulerAuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Аудит планировщика задач и WMI">

    <Page.DataContext>
        <vm:TaskSchedulerAuditViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoTimer}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Глубокий аудит планировщика задач и WMI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Сканирование скрытых задач Windows Task Scheduler, автозапуска при простое или входе в систему и постоянных потребителей событий WMI (CommandLineEventConsumer)."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ScanTasksCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Сканировать" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteAllSuspiciousCommand}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoGarbage}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Очистить подозрительные" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Metrics Summary Grid -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Всего обнаружено задач" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalTasksCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Подозрительные и аномальные" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SuspiciousTasksCount}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Скрытые WMI подписки" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding WmiCount}" FontSize="18" FontWeight="Bold" Foreground="#A855F7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Filter and Search Toolbar -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category Filters -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Все" Content="Все задачи" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4" FontSize="11" FontWeight="Bold"/>
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Планировщик" Content="Планировщик задач" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4" FontSize="11" FontWeight="Bold"/>
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="WMI" Content="WMI потребители событий" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4" FontSize="11" FontWeight="Bold"/>
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Подозрительные" Content="⚠️ Подозрительные" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                    </WrapPanel>

                    <!-- Search Box -->
                    <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" MinWidth="220" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Tasks List -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Задачи автозапуска и системные триггеры" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding FilteredTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Type Badge Icon -->
                                        <Border Grid.Column="0" Background="{Binding TypeBgColor}" BorderBrush="{Binding TypeBadgeColor}" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoTask}" Fill="{Binding TypeBadgeColor}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TaskName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border Background="{Binding TypeBgColor}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding TypeBadgeColor}"/>
                                                </Border>
                                                <Border Background="#1A64748B" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Trigger}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ActionCommand}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RiskReason}" FontSize="10" Foreground="{Binding RiskBadgeColor}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Risk Badge -->
                                        <Border Grid.Column="2" Background="{Binding RiskBgColor}" BorderBrush="{Binding RiskBadgeColor}" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RiskBadgeColor}"/>
                                        </Border>

                                        <!-- State / Toggle Button -->
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="12,6" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="10,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoGarbage}" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                                <TextBlock Text="Удалить" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
