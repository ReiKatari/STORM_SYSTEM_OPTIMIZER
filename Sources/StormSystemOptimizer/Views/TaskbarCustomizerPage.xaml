<Page x:Class="StormSystemOptimizer.Views.TaskbarCustomizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Панель задач и меню Пуск">

    <Page.DataContext>
        <vm:TaskbarCustomizerViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <!-- Segmented Card RadioButton Style with Neon Glow Active State -->
        <Style x:Key="SegmentCardRadioStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <Border x:Name="ActiveIndicator" Grid.Column="1"
                                        Width="12" Height="12" CornerRadius="6"
                                        Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2"
                                        Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="RootBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource AccentGlowBrush}"/>
                                <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="ActiveIndicator" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                <Setter TargetName="RootBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="2.5" Direction="270" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elevated Toggle Card Button Style -->
        <Style x:Key="ToggleCardButtonStyle" TargetType="Button" BasedOn="{StaticResource StormSecondaryButton}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoMonitor}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Панель задач и меню Пуск" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Тонкая настройка панели задач: выравнивание, размер, режим группировки кнопок, эффекты акрилового размытия (Acrylic Blur) и панели инструментов."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RestartExplorerCommand}" Style="{StaticResource StormHeroButton}" Padding="16,10">
                            <TextBlock Text="Перезапустить Проводник" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Card 1: Layout & Alignment Segmented Controls -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Расположение и выравнивание значков" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Мгновенное переключение позиции кнопки Пуск и закрепленных значков с прямой трансляцией системного события WM_SETTINGCHANGE."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- Alignment Segmented Cards -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="AlignmentGroup"
                                     IsChecked="{Binding IsLeftAlignment, Mode=OneWay}"
                                     Command="{Binding SelectAlignmentCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>0</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Слева (Windows 10)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Классическое выравнивание кнопки Пуск и значков слева" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="1" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="AlignmentGroup"
                                     IsChecked="{Binding IsCenterAlignment, Mode=OneWay}"
                                     Command="{Binding SelectAlignmentCommand}"
                                     Margin="0">
                            <RadioButton.CommandParameter>
                                <sys:Int32>1</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="По центру (Windows 11)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Современное центрированное расположение по стандарту Windows 11" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Taskbar Size Segmented Cards -->
                    <TextBlock Text="Размер панели задач (Высота и масштаб кнопок)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Выбор высоты панели задач для оптимизации полезного пространства экрана." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="SizeGroup"
                                     IsChecked="{Binding IsSmallSize, Mode=OneWay}"
                                     Command="{Binding SelectSizeCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>0</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Компактная (Small)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Тонкая панель, максимум места" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="1" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="SizeGroup"
                                     IsChecked="{Binding IsMediumSize, Mode=OneWay}"
                                     Command="{Binding SelectSizeCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>1</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Стандартная (Medium)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Системный масштаб Windows" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="2" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="SizeGroup"
                                     IsChecked="{Binding IsLargeSize, Mode=OneWay}"
                                     Command="{Binding SelectSizeCommand}"
                                     Margin="0">
                            <RadioButton.CommandParameter>
                                <sys:Int32>2</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Увеличенная (Large)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Крупные кнопки для 4K экранов" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Grouping Mode Segmented Cards -->
                    <TextBlock Text="Режим группировки кнопок и метки окон" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Управление показом текстовых заголовков окон на панели задач." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="GroupingGroup"
                                     IsChecked="{Binding IsGroupingAlways, Mode=OneWay}"
                                     Command="{Binding SelectGroupingCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>0</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Всегда объединять" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Скрывать текстовые метки" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="1" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="GroupingGroup"
                                     IsChecked="{Binding IsGroupingWhenFull, Mode=OneWay}"
                                     Command="{Binding SelectGroupingCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>1</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="При заполнении" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Группировать при нехватке места" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="2" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="GroupingGroup"
                                     IsChecked="{Binding IsGroupingNever, Mode=OneWay}"
                                     Command="{Binding SelectGroupingCommand}"
                                     Margin="0">
                            <RadioButton.CommandParameter>
                                <sys:Int32>2</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Никогда не объединять" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Всегда показывать заголовки" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Search Box Mode Segmented Cards -->
                    <TextBlock Text="Стиль строки поиска Windows" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Настройка компактности элемента поиска на панели задач." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton Grid.Column="0" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="SearchGroup"
                                     IsChecked="{Binding IsSearchHidden, Mode=OneWay}"
                                     Command="{Binding SelectSearchBoxCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>0</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Скрыть" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Без поиска" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="1" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="SearchGroup"
                                     IsChecked="{Binding IsSearchIcon, Mode=OneWay}"
                                     Command="{Binding SelectSearchBoxCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>1</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Только значок" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Компактная лупа" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="2" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="SearchGroup"
                                     IsChecked="{Binding IsSearchBox, Mode=OneWay}"
                                     Command="{Binding SelectSearchBoxCommand}">
                            <RadioButton.CommandParameter>
                                <sys:Int32>2</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Поле поиска" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Полная строка" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Grid.Column="3" Style="{StaticResource SegmentCardRadioStyle}"
                                     GroupName="SearchGroup"
                                     IsChecked="{Binding IsSearchButton, Mode=OneWay}"
                                     Command="{Binding SelectSearchBoxCommand}"
                                     Margin="0">
                            <RadioButton.CommandParameter>
                                <sys:Int32>3</sys:Int32>
                            </RadioButton.CommandParameter>
                            <StackPanel>
                                <TextBlock Text="Кнопка поиска" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Значок и надпись" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Interactive Toggles Grid (6 Windows & Start Menu Settings) -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Быстрые переключатели панели задач и меню Пуск" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Нажмите на любую карточку для мгновенного включения или отключения соответствующей функции Windows."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <UniformGrid Columns="2">
                        <!-- Auto-Hide Taskbar -->
                        <Button Style="{StaticResource ToggleCardButtonStyle}" Command="{Binding ToggleAutoHideCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Автоматически скрывать панель задач" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Скрывать панель задач при отсутствии курсора" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsTaskbarAutoHide, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Lock Taskbar -->
                        <Button Style="{StaticResource ToggleCardButtonStyle}" Command="{Binding ToggleLockTaskbarCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Закрепить панель задач" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Защита от случайного изменения размера или позиции" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsTaskbarLocked, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Task View Button -->
                        <Button Style="{StaticResource ToggleCardButtonStyle}" Command="{Binding ToggleTaskViewCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Кнопка «Вид задач»" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Отображение переключателя виртуальных рабочих столов" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsTaskViewVisible, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Widgets & Weather -->
                        <Button Style="{StaticResource ToggleCardButtonStyle}" Command="{Binding ToggleWidgetsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Виджеты и погода" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Показ значка виджетов и погоды в углу экрана" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsWidgetsVisible, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Seconds in Clock -->
                        <Button Style="{StaticResource ToggleCardButtonStyle}" Command="{Binding ToggleSecondsInClockCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Секунды в системных часах" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Отображение точного времени с секундами в трее" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSecondsInClock, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Hide Recommended in Start Menu -->
                        <Button Style="{StaticResource ToggleCardButtonStyle}" Command="{Binding ToggleHideRecommendedCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Скрыть раздел «Рекомендуем» в меню Пуск" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Очистить меню Пуск от недавних файлов и советов" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsHideRecommended, Mode=OneWay}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Card 3: Acrylic Blur & Transparency Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Прозрачность и акриловое размытие (Acrylic Blur)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Аппаратные эффекты DWM через SetWindowCompositionAttribute для панели задач с настраиваемым уровнем размытия и оттенка." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button Command="{Binding ApplyAcrylicBlurCommand}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,10,6">
                            <TextBlock Text="Акриловое размытие (Acrylic)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <Button Command="{Binding ApplyTransparentCommand}" Style="{StaticResource StormSecondaryButton}" Padding="16,10" Margin="0,0,10,6">
                            <TextBlock Text="Полная прозрачность (Clear)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding ResetTaskbarStyleCommand}" Style="{StaticResource StormSecondaryButton}" Padding="16,10" Margin="0,0,0,6">
                            <TextBlock Text="Стандартный стиль Windows" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: Custom Start Icon Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Кастомный значок кнопки Пуск" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Замена стандартного логотипа кнопки Пуск на собственное изображение (.ico или .png)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                            <TextBox Text="{Binding CustomStartIconPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        <Button Grid.Column="1" Command="{Binding BrowseStartIconCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Выбрать значок..." FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ApplyStartIconCommand}" Style="{StaticResource StormHeroButton}" Padding="16,8">
                            <TextBlock Text="Применить значок" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 5: Quick Toolbars / Folder Toolbar Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Быстрые панели инструментов и папки" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Создание всплывающей панели быстрого доступа на панели задач для любой выбранной папки компьютера." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <TextBox Text="{Binding QuickToolbarFolderName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                            <TextBox Text="{Binding QuickToolbarFolderPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>

                        <Button Grid.Column="2" Command="{Binding BrowseQuickToolbarFolderCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                            <TextBlock Text="Обзор папки..." FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>

                        <Button Grid.Column="3" Command="{Binding AddQuickToolbarFolderCommand}" Style="{StaticResource StormHeroButton}" Padding="16,8">
                            <TextBlock Text="Закрепить панель" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <TextBlock Text="{Binding StatusMessage, StringFormat='💡 Статус: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
