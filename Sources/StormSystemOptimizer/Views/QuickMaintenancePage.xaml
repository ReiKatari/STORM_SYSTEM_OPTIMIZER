<Page x:Class="StormSystemOptimizer.Views.QuickMaintenancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Быстрое обслуживание">

    <Page.DataContext>
        <vm:QuickMaintenanceViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Hero Banner Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoQuickMaintenance}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Быстрое комплексное обслуживание системы" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Автоматическое 100% безопасное обслуживание Windows в один клик: создание точки восстановления и бэкапа реестра, глубокая очистка кэша, выгрузка Standby List оперативной памяти, оптимизация таймеров ядра до 0.500 мс и тюнинг задержек."
                                   FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Статус: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Circular Glowing Interactive Action Button -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="144" Height="144">
                            <!-- Rotating Cyber Glow Aura (Active when running) -->
                            <Rectangle x:Name="GlowRing" Width="140" Height="140" RadiusX="70" RadiusY="70"
                                       RenderTransformOrigin="0.5,0.5"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}}">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00D2FF" Offset="0.0"/>
                                        <GradientStop Color="#10B981" Offset="0.3"/>
                                        <GradientStop Color="#F59E0B" Offset="0.6"/>
                                        <GradientStop Color="#EC4899" Offset="0.8"/>
                                        <GradientStop Color="#00D2FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.Effect>
                                    <BlurEffect Radius="16"/>
                                </Rectangle.Effect>
                                <Rectangle.RenderTransform>
                                    <RotateTransform x:Name="GlowRotate" Angle="0"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="GlowRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:2.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>

                            <!-- Circular Button Base -->
                            <Border Width="124" Height="124" CornerRadius="62" Background="#0F172A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" Color="#00D2FF" Opacity="0.35" ShadowDepth="0"/>
                                </Border.Effect>
                                <Button Command="{Binding StartMaintenanceCommand}"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="58" Margin="4">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#00D2FF" Offset="0.0"/>
                                                        <GradientStop Color="#10B981" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoQuickMaintenance}" Fill="#FFFFFF" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding ButtonText}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Overall Progress Bar -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Общий прогресс оптимизации" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}%'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Completion Dashboard Report (Visible when completed) -->
            <Border Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#1A10B981" CornerRadius="6" Padding="4" Margin="0,0,8,0">
                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>
                        <TextBlock Text="Дашборд и отчет ускорения системы" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 6-Metric Acceleration Dashboard -->
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <!-- Metric 1: Latency / DPC -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Снижение задержки (DPC / Input)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding LatencyReductionText}" FontSize="17" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 2: Boot Speedup -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Ускорение старта Windows" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding BootSpeedupText}" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 3: DWM Smoothness -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Плавность рабочего стола и DWM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DwmSmoothnessText}" FontSize="17" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 4: Freed Space -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Очищено дискового мусора" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding FreedSpaceText}" FontSize="17" FontWeight="Bold" Foreground="#00D2FF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 5: Freed RAM -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Освобождено памяти RAM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding FreedRamText}" FontSize="17" FontWeight="Bold" Foreground="#A855F7" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 6: NT Kernel Timer -->
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Таймер ядра NT" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TimerResolutionText}" FontSize="17" FontWeight="Bold" Foreground="#F43F5E" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Hardware Status Strip -->
                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚡ Изоляция CPU Sets: " FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text="{Binding CpuSetsStatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"/>
                            <TextBlock Text="🎮 Опрос USB xHCI / QoS: " FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="{Binding NetworkImodStatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Maintenance Steps Checklist -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Пошаговый комплекс процедур (24 этапа)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Themed Vector Icon Box -->
                                        <Border Grid.Column="0" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Path Data="{Binding IconGeometry}" Fill="{Binding IconBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Title and Description with Category Badge -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
