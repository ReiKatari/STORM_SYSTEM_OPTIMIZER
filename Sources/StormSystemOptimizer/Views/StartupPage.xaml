<Page x:Class="StormSystemOptimizer.Views.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      xmlns:ctrl="clr-namespace:StormSystemOptimizer.Controls"
      Title="Управление автозагрузкой">

    <Page.DataContext>
        <vm:StartupViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel>
            <!-- Top Header -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Менеджер автозагрузки Windows" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Отключение ресурсоемких фоновых программ значительно ускоряет время загрузки системы и освобождает оперативную память."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Header Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AddCustomAppCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormSecondaryButton}"
                                Padding="12,10"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoExplorer}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Добавить программу" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ApplyStartupChangesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormHeroButton}"
                                Padding="16,10"
                                Margin="0,0,8,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoDisks}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Применить изменения" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding LoadStartupAppsCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormSecondaryButton}"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Обновить" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Comparative Impact Banner -->
            <ctrl:ComparativeImpactControl Icon="⏱️" MetricTitle="Время старта Windows" MetricSubtitle="Оптимизация автозагрузки и отключение тяжелых лаунчеров" BeforeValue="42 сек" AfterValue="18 сек" BadgeText="-57% быстрее" Margin="0,0,0,12"/>

            <!-- Filter and Search Toolbar -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Categories -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Все" Content="Все элементы" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4" FontSize="11" FontWeight="Bold"/>
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Реестр" Content="Реестр (Run)" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4" FontSize="11" FontWeight="Bold"/>
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Папка" Content="Папка автозапуска" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4" FontSize="11" FontWeight="Bold"/>
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Службы" Content="Службы" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,0,4" FontSize="11" FontWeight="Bold"/>
                    </WrapPanel>

                    <!-- Search Input -->
                    <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" MinWidth="220" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Startup Items List -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Программы и компоненты в автозапуске" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding FilteredStartupItems.Count, StringFormat='Найдено: {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding FilteredStartupItems}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Name & Command -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Раздел: " FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Location}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text=" • Издатель: " FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Impact Badge & Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Background="{Binding ImpactBgColor}" BorderBrush="{Binding ImpactTextColor}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Влияние: " FontSize="10.5" Foreground="{Binding ImpactTextColor}"/>
                                                <TextBlock Text="{Binding Impact}" FontSize="11" FontWeight="Bold" Foreground="{Binding ImpactTextColor}"/>
                                            </StackPanel>
                                        </Border>

                                        <Button Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Открыть расположение файла в Проводнике"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="8,6"
                                                Margin="0,0,6,0">
                                            <Path Data="{StaticResource GeoExplorer}" Fill="{DynamicResource AccentPrimaryBrush}" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Удалить запись из автозапуска"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="8,6">
                                            <Path Data="{StaticResource GeoGarbage}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Dynamic State Toggle CheckBox (Активно / Отключено) -->
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="8,0,4,0"
                                              Content="{Binding StateText}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </StackPanel>
            </Border>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы по Автозагрузке (FAQ)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoRocket}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Насколько отключение программ ускоряет старт Windows?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Отключение тяжелых приложений (лаунчеры, мессенджеры, автоапдейтеры) ускоряет загрузку рабочего стола на 30–60% и экономит до 1.5 ГБ ОЗУ сразу после старта ПК." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoShield}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Не повредит ли отключение автозапуска работу программ?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Нет. Программа просто перестает запускаться автоматически при включении ПК, но в любой момент может быть запущена вами вручную через ярлык на рабочем столе или в Пуске." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
