<Page x:Class="StormSystemOptimizer.Views.SoftwareUpdaterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Обновление программ">

    <Page.DataContext>
        <vm:SoftwareUpdaterViewModel/>
    </Page.DataContext>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="20,20,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoAppUpdate}" Fill="{StaticResource IconGradEmerald}" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Центр обновления программ и игр" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Автоматическое фоновое сканирование установленных приложений, тихое обновление в один клик без открытия сайтов и управление черным списком."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatsSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SilentUpdateAllCommand}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoAppUpdate}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Обновить всё тихо" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadUpdatesCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource AccentPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Сканировать" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search & Filters Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="4,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Filters -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Все" IsChecked="True" Style="{StaticResource NavRadioButtonStyle}" Click="FilterAll_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="⚡ Требуют обновления" Style="{StaticResource NavRadioButtonStyle}" Click="FilterUpdates_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="🌐 Браузеры" Style="{StaticResource NavRadioButtonStyle}" Click="FilterBrowsers_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="🎮 Игры" Style="{StaticResource NavRadioButtonStyle}" Click="FilterGames_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="🛠️ Утилиты" Style="{StaticResource NavRadioButtonStyle}" Click="FilterUtils_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="🎬 Медиа" Style="{StaticResource NavRadioButtonStyle}" Click="FilterMedia_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="💻 Разработка" Style="{StaticResource NavRadioButtonStyle}" Click="FilterDev_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="✅ Актуальные" Style="{StaticResource NavRadioButtonStyle}" Click="FilterActual_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <RadioButton Content="🔒 Черный список" Style="{StaticResource NavRadioButtonStyle}" Click="FilterBlacklist_Click" Margin="0,0,6,0" Padding="10,5"/>
                    <CheckBox Content="🧪 Показывать бета-версии" IsChecked="{Binding ShowBetaVersions, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource AccentSecondaryBrush}" FontWeight="Bold" FontSize="11.5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Apps List -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="20,0,20,12">
            <Grid>
                <!-- Items list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DisplayApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name & Publisher & Type Badge -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <Border Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeColor}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppType}" FontSize="10" FontWeight="Bold" Foreground="{Binding TypeBadgeColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Publisher, StringFormat='{}Поставщик: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Installed Version -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding InstalledVersion, StringFormat='{}Установлена: v{0}'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Текущая версия в системе" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Available Version -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding AvailableVersion, StringFormat='{}Доступна: v{0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text="Официальный репозиторий" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            
                                            <!-- Update Button (When IsUpdateAvailable == true) -->
                                            <Button Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}"
                                                    Command="{Binding DataContext.SilentUpdateAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormHeroButton}"
                                                    Padding="14,8"
                                                    Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoAppUpdate}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Обновить" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Actual Badge (When IsUpdateAvailable == false && IsBlacklisted == false) -->
                                            <Border Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsUpdateAvailable}" Value="False"/>
                                                                    <Condition Binding="{Binding IsBlacklisted}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoCheck}" Fill="#10B981" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Актуальна" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Blacklisted Badge (When IsBlacklisted == true) -->
                                            <Border Background="#26EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0"
                                                    Visibility="{Binding IsBlacklisted, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="В черном списке" FontSize="10.5" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Blacklist Toggle Button -->
                                            <Button Command="{Binding DataContext.ToggleBlacklistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="8,8"
                                                    ToolTip="Добавить/Убрать из черного списка">
                                                <Path Data="{StaticResource GeoShield}" Fill="{DynamicResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Animated Loading Overlay -->
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                      Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource StormCircularLoadingSpinner}" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Сверка версий с репозиторием Winget и облачным каталогом..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bottom Banner -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="100% Безопасное обновление • Официальные репозитории" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
