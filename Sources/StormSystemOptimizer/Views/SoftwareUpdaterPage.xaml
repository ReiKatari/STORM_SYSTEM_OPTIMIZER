<Page x:Class="StormSystemOptimizer.Views.SoftwareUpdaterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Обновление программ">

    <Page.DataContext>
        <vm:SoftwareUpdaterViewModel/>
    </Page.DataContext>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="20,20,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradEmerald}" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Центр обновления программ и игр" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Автоматическое фоновое сканирование установленных приложений, тихое обновление в один клик без открытия сайтов и управление черным списком."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatsSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SilentUpdateAllCommand}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoClean}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="⚡ Обновить всё тихо" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadUpdatesCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8">
                        <TextBlock Text="🔄 Сканировать" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Все программы" IsChecked="True" Style="{StaticResource NavRadioButtonStyle}" Click="FilterAll_Click" Margin="0,0,8,0" Padding="12,6"/>
                <RadioButton Content="⚡ Требуют обновления" Style="{StaticResource NavRadioButtonStyle}" Click="FilterUpdates_Click" Margin="0,0,8,0" Padding="12,6"/>
                <RadioButton Content="✅ Актуальные" Style="{StaticResource NavRadioButtonStyle}" Click="FilterActual_Click" Margin="0,0,8,0" Padding="12,6"/>
                <RadioButton Content="🔒 Черный список" Style="{StaticResource NavRadioButtonStyle}" Click="FilterBlacklist_Click" Margin="0,0,8,0" Padding="12,6"/>
            </StackPanel>
        </Border>

        <!-- Apps List -->
        <!-- Online Checking Progress Banner -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="20,0,20,8"
                Visibility="{Binding IsCheckingOnline, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="⚡ Фоновый опрос репозиториев Winget и облачных каталогов..." FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    <TextBlock Text="Идет опрос версий..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Main Apps List -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="20,0,20,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DisplayApps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Name & Publisher & Type Badge -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Border Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeColor}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppType}" FontSize="10" FontWeight="Bold" Foreground="{Binding TypeBadgeColor}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Publisher, StringFormat='{}Поставщик: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Installed Version -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding InstalledVersion, StringFormat='{}Установлена: v{0}'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Текущая версия в системе" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Available Version -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding AvailableVersion, StringFormat='{}Доступна: v{0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        <TextBlock Text="Официальный репозиторий" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        
                                        <!-- Update Button (When IsUpdateAvailable == true) -->
                                        <Button Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}"
                                                Command="{Binding DataContext.SilentUpdateAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StormHeroButton}"
                                                Padding="12,8"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoLog}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="⚡ Обновить" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Actual Badge (When IsUpdateAvailable == false && IsBlacklisted == false) -->
                                        <Border Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsUpdateAvailable}" Value="False"/>
                                                                <Condition Binding="{Binding IsBlacklisted}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource GeoCheck}" Fill="#10B981" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Актуальна" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Blacklist Toggle Button -->
                                        <Button Command="{Binding DataContext.ToggleBlacklistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="10,8"
                                                ToolTip="Добавить/удалить из черного списка (игнорировать обновления)">
                                            <Path Data="{StaticResource GeoLock}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- FAQ Section with Gradient Vector Icons -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Частые вопросы по Обновлению программ (FAQ)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Как работает тихое обновление без открытия сайтов?" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <TextBlock Text="STORM обращается к защищенному системному менеджеру пакетов Windows Package Manager (Winget). Пакет скачивается с официального репозитория разработчика и устанавливается с параметрами тихой установки (--silent) в фоновом режиме." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                </Expander>
                <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoLock}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Зачем нужен черный список программ?" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <TextBlock Text="Если вам требуется оставаться на конкретной версии программы или плагина, вы можете добавить приложение в черный список. Программа будет полностью исключена из автоматических проверок и обновлений." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Status Bottom Banner -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="20,0,20,20">
            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
        </Border>
    </Grid>
</Page>
