<Page x:Class="StormSystemOptimizer.Views.GameLaunchersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Менеджер игровых лаунчеров и медиатек">

    <Page.DataContext>
        <vm:GameLaunchersViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoLaunchers}" Fill="{StaticResource IconGradRose}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Менеджер игровых лаунчеров и медиатек" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Индивидуальное и глобальное управление платформами: LaunchBox и BigBox, Steam, Epic Games, EA App, GOG Galaxy, Battle.net, Playnite, RetroArch, Discord, Ubisoft, VK Play, Rockstar. Точечная очистка кэшей, выгрузка перед игрой и тонкая оптимизация."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Command="{Binding ApplyLauncherTweaksCommand}" Style="{StaticResource StormHeroButton}" Padding="18,10" Margin="0,0,0,8">
                            <TextBlock Text="Оптимизировать все лаунчеры" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding CleanAllLauncherCachesCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,4">
                                <TextBlock Text="Очистить весь кэш" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Command="{Binding KillAllRunningLaunchersCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,0,4">
                                <TextBlock Text="Выгрузить всё" FontSize="11.5" FontWeight="Bold" Foreground="#EF4444"/>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detected Launchers & Individual Controls Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoGamepad}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Обнаруженные игровые платформы и индивидуальное управление" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding DetectLaunchersCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand">
                            <TextBlock Text="Сканировать диски" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Launchers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Real Application Icon -->
                                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding RealIcon}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding RealIcon, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding IconEmoji}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding RealIcon, Converter={StaticResource NonNullToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Info Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                
                                                <!-- Category Badge -->
                                                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                </Border>

                                                <!-- Running / Inactive Badge -->
                                                <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1A64748B"/>
                                                            <Setter Property="BorderBrush" Value="#3364748B"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Background" Value="#1A10B981"/>
                                                                    <Setter Property="BorderBrush" Value="#3310B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Остановлен"/>
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Text" Value="● Активен"/>
                                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            
                                            <!-- Path & Cache Info -->
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBlock Text="Путь: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="Кэш: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding CacheSizeFormatted}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Actions Per Launcher -->
                                        <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <!-- Clean Cache -->
                                            <Button Command="{Binding DataContext.CleanLauncherCacheCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,4" ToolTip="Очистить временные файлы и кэш этого лаунчера">
                                                <TextBlock Text="Кэш" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Button>

                                            <!-- Optimize Launcher -->
                                            <Button Command="{Binding DataContext.OptimizeLauncherCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,4" ToolTip="Применить твики производительности для этого лаунчера">
                                                <TextBlock Text="Твики" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Button>

                                            <!-- Open Folder -->
                                            <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,4" ToolTip="Открыть папку установки и библиотеку игр">
                                                <TextBlock Text="Папка" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Button>

                                            <!-- Launch App -->
                                            <Button Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,4" ToolTip="Запустить клиент">
                                                <TextBlock Text="Запуск" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Button>

                                            <!-- Kill Process (if running) -->
                                            <Button Command="{Binding DataContext.KillLauncherCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,0,4" ToolTip="Выгрузить фоновые процессы из памяти">
                                                <TextBlock Text="Выгрузить" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Global Optimization Options Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Тонкие системные параметры игровых клиентов и оверлеев" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <CheckBox IsChecked="{Binding OptimizeLaunchBox}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Аппаратное DirectX ускорение LaunchBox и BigBox и высокий приоритет эмуляторов" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Обеспечивает плавные 60-120 FPS в интерфейсе BigBox и исключает просадки кадровой частоты в эмуляторах." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding OptimizeSteam}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Оптимизация процессов Steam Web Helper (SmoothScrollWebViews = 0, H.264 HW)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Уменьшает использование оперативной памяти и фоновую нагрузку на CPU встроенного браузера Steam." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding OptimizeDiscord}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Устранение задержек Discord (Отключение фоновой телеметрии и краш-дампов)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Предотвращает скачки времени кадра (Frame Time) во время голосовой связи и демонстрации экрана." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding DisableXboxGameBar}">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Отключение фоновой службы Xbox GameDVR (AppCaptureEnabled = 0)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Ликвидирует скрытую непрерывную буферизацию видеопотока, экономя ресурс видеокарты и SSD." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
