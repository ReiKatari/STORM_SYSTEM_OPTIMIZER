<Page x:Class="StormSystemOptimizer.Views.BiosOptimizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Настройки BIOS">

    <Page.DataContext>
        <vm:BiosOptimizerViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Motherboard & Firmware Telemetry Hero Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoBios}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Настройки BIOS и Рекомендации для вашей материнской платы" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Индивидуальный анализ чипсета и прошивки UEFI. Проверенные, 100% безопасные аппаратные параметры без риска перегрева или повреждения компонентов."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Hardware Badges -->
                        <WrapPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Плата: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding MotherboardManufacturer}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text=" " FontSize="11"/>
                                    <TextBlock Text="{Binding MotherboardModel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BiosVersion}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock Text=" (" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding BiosDate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="CPU: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CpuSummary}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ОЗУ: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding RamSummary}" FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="GPU: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding GpuSummary}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,6">
                                <TextBlock Text="{Binding TelemetrySummary}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Command="{Binding RebootToBiosCommand}"
                                Style="{StaticResource StormHeroButton}"
                                Padding="14,10"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoPower}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Перезагрузка в BIOS" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportBiosGuideCommand}"
                                Style="{StaticResource StormSecondaryButton}"
                                Padding="12,10"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoLog}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Шпаргалка" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PrintBiosGuideCommand}"
                                Style="{StaticResource StormSecondaryButton}"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradEmerald}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Распечатать" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Modern Segmented Tabs Bar -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,8" Margin="0,0,0,14">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <!-- All Recommendations Tab -->
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Все настройки" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Все рекомендации" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#2600D2FF" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding TotalCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- CPU Tab -->
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Процессор" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoCpu}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Процессор и ядра" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#2600D2FF" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding CpuCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- RAM Tab -->
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Память" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoRam}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Память XMP и EXPO" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#26A855F7" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding RamCount}" FontSize="10" FontWeight="Bold" Foreground="#A855F7"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- GPU Tab -->
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Видеокарта" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoGpu}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Видеокарта и ReBAR" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#2610B981" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding GpuCount}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- PCIe Tab -->
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Шина PCIe" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDisk}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Шина PCIe и NVMe" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#26F59E0B" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding PcieCount}" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Boot Tab -->
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Загрузка" Style="{StaticResource StormSecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoPower}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Загрузка и UEFI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#26F43F5E" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding BootCount}" FontSize="10" FontWeight="Bold" Foreground="#F43F5E"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Cooling Tab -->
                        <Button Command="{Binding FilterCategoryCommand}" CommandParameter="Охлаждение" Style="{StaticResource StormSecondaryButton}" Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Охлаждение и PWM" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Background="#2610B981" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding CoolingCount}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Recommended Settings Cards List -->
            <ItemsControl ItemsSource="{Binding FilteredSettings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header Row: Title & Impact Badge -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,4"/>
                                    </WrapPanel>

                                    <!-- Performance Impact Badge -->
                                    <Border Grid.Column="1" Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Top" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding PerformanceImpact}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- Description & Explanation -->
                                <TextBlock Grid.Row="1" Text="{Binding Explanation}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <!-- Hardware Navigation Path Box -->
                                <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="📍 Меню вашей платы: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding ActiveBoardPath}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>

                                        <Border Grid.Column="2" Background="#1A10B981" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RecommendedValue}" FontSize="11" FontWeight="Bold" Foreground="#10B981" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,4,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы по Настройкам BIOS (FAQ)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoShield}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Могут ли эти настройки привести к перегреву или поломке?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Категорически нет! Все представленные настройки (XMP/EXPO, Resizable BAR, UEFI, C-States, SpeedShift) являются сертифицированными стандартами Intel, AMD и PCI-SIG. Мы исключили опасный овервольтинг и экстремальный разгон, оставив только эффективную заводскую оптимизацию шин и прошивки." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Как быстро перезагрузиться в BIOS без нажатия Del/F2?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Нажмите кнопку «Перезагрузка в BIOS» вверху страницы. Windows выполнит команду перезагрузки с флагом прошивки (/r /fw), и при старте ПК материнская плата автоматически откроет меню BIOS UEFI." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoGame}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Зачем нужен Resizable BAR в играх?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Традиционно процессор отправляет видеокарте текстуры мелкими блоками по 256 МБ. Технология Resizable BAR открывает доступ сразу ко всей видеопамяти (8, 12, 16 ГБ), снижая задержки рендеринга и повышая стабильность частоты кадров (0.1% Low)." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
