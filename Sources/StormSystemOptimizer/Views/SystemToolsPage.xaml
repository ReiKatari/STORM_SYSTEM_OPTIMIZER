<Page x:Class="StormSystemOptimizer.Views.SystemToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="System Tools">

    <Page.DataContext>
        <vm:SystemToolsViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Top Header -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSystemTools}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Инструменты восстановления, глубокой оптимизации и оснастки" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Глубокая проверка целостности системных файлов, восстановление образа ОС, режим MSI для шины PCIe, тюнинг DirectStorage 1.2, очистка Standby памяти и быстрый доступ к системным оснасткам."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Статус: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ToolStatus}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Advanced Hardware & Memory Tweaks (MSI Mode, DirectStorage, Standby Purge, Snapshot) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Аппаратный тюнинг PCIe, DirectStorage и память ядра" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- MSI Mode -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AFB7185" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoGpu}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Режим MSI (Message Signaled Interrupts)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Перевод GPU и контроллеров USB в режим прерываний MSI для минимизации Input Lag." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            
                            <!-- Live Status Badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsMsiActive, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ ВКЛЮЧЕНО (Режим MSI активен)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsMsiActive, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ ОТКЛЮЧЕНО (Line-based режим)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Action Button -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsMsiActive, Converter={StaticResource InverseBoolToVisConverter}}"
                                    Command="{Binding ToggleMsiModeCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="⚡ Включить"
                                    Style="{StaticResource StormHeroButton}"
                                    Padding="14,6"/>
                            <Button Visibility="{Binding IsMsiActive, Converter={StaticResource BoolToVisConverter}}"
                                    Command="{Binding ToggleMsiModeCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="Отключить"
                                    Style="{StaticResource StormSecondaryButton}"
                                    Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DirectStorage 1.2 & NVMe BypassIO -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A34D399" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradEmerald}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Тюнинг DirectStorage 1.2 &amp; BypassIO" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Оптимизация очередей Win32 IoRing и разгрузка шины ввода-вывода для игр." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            
                            <!-- Live Status Badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsDirectStorageActive, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ НАСТРОЕНО (BypassIO &amp; IoRing активны)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsDirectStorageActive, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ СТАНДАРТНЫЙ РЕЖИМ" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Action Button -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsDirectStorageActive, Converter={StaticResource InverseBoolToVisConverter}}"
                                    Command="{Binding ToggleDirectStorageCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="⚡ Включить"
                                    Style="{StaticResource StormHeroButton}"
                                    Padding="14,6"/>
                            <Button Visibility="{Binding IsDirectStorageActive, Converter={StaticResource BoolToVisConverter}}"
                                    Command="{Binding ToggleDirectStorageCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="Сбросить"
                                    Style="{StaticResource StormSecondaryButton}"
                                    Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Standby Memory Purge -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AC084FC" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoRam}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Очистка кэша Standby List ОЗУ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Мгновенное освобождение кэшированной памяти ожидания через NtSetSystemInformation." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Border Visibility="{Binding IsStandbyPurged, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="✓ Очищено (Память свободна)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>
                        <Button Command="{Binding PurgeStandbyMemoryCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Очистить" Style="{StaticResource StormSecondaryButton}" Padding="14,6" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Snapshot & Rollback -->
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A38BDF8" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource IconGradSky}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Снимок параметров (Snapshot &amp; Rollback)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Резервный снимок критических параметров реестра перед тюнингом для быстрого отката." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding CreateSnapshotCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Создать снимок" Style="{StaticResource StormSecondaryButton}" Padding="14,6" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Deep Repair Utilities Grid -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoSystemTools}" Fill="{StaticResource IconGradAmber}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Системное восстановление и глубокая очистка" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SFC Scannow -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A00D2FF" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Проверка системных файлов (SFC)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Сканирует и восстанавливает поврежденные системные библиотеки Windows." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding RunSfcScanCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Запустить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>

                <!-- DISM RestoreHealth -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AC084FC" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Восстановление образа DISM" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Восстанавливает поврежденные системные компоненты из хранилища обновлений." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding RunDismRestoreCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Запустить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>

                <!-- WinSxS Cleanup -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A34D399" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradEmerald}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Очистка хранилища WinSxS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Удаляет устаревшие резервные копии компонентов Windows после обновлений." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding CleanWinSxSCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Очистить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>

                <!-- Reset Winsock -->
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A38BDF8" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Сброс сетевого каталога Winsock" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Сбрасывает конфигурацию каталога Winsock при сетевых сбоях или потере соединения." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding ResetWinsockCommand}" Grid.Column="1" Content="Сбросить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>

                <!-- Clear Event Logs -->
                <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AFB7185" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoLog}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Очистка журналов событий" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Очищает переполненные журналы Windows Event Viewer (Application, System, Security)." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding ClearEventLogsCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Очистить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>

                <!-- Clean Temp / Prefetch -->
                <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A00D2FF" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Очистка Temp и Prefetch" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Принудительно удаляет заблокированные временные файлы %TEMP% и Windows\Temp." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding CleanTempFilesCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Очистить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>

                <!-- Rebuild Icon Cache -->
                <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AFBBF24" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource IconGradAmber}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Перестроить кэш иконок" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Исправляет поврежденные или белые иконки ярлыков на Рабочем столе и в папках." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding RebuildIconCacheCommand}" Grid.Column="1" Content="Сбросить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>

                <!-- Reset Store (wsreset) -->
                <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AFB7185" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Сброс кэша Магазина Windows" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Очищает кэш Microsoft Store при сбоях загрузки приложений и игр." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding ResetWindowsStoreCommand}" Grid.Column="1" Content="Сбросить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Quick Snapin Launchers with High-Definition Vector Icons -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Быстрый вызов системных оснасток Windows" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                <UniformGrid Columns="4" HorizontalAlignment="Stretch">
                    <!-- 1. Device Manager -->
                    <Button Click="BtnSnapin_Click" Tag="DeviceManager" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDevice}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Диспетчер устройств" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. Task Manager -->
                    <Button Click="BtnSnapin_Click" Tag="TaskManager" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A34D399" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoTask}" Fill="{StaticResource IconGradEmerald}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Диспетчер задач" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. Regedit -->
                    <Button Click="BtnSnapin_Click" Tag="Regedit" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoKey}" Fill="{StaticResource IconGradAmber}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Редактор реестра" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4. DxDiag -->
                    <Button Click="BtnSnapin_Click" Tag="DxDiag" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoGame}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="DirectX Диагностика" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5. GpEdit -->
                    <Button Click="BtnSnapin_Click" Tag="GpEdit" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoShield}" Fill="{StaticResource IconGradSky}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Групповые политики" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 6. Event Viewer -->
                    <Button Click="BtnSnapin_Click" Tag="EventViewer" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoLog}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Журнал событий" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 7. CleanMgr -->
                    <Button Click="BtnSnapin_Click" Tag="CleanMgr" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Очистка диска" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 8. ResMon -->
                    <Button Click="BtnSnapin_Click" Tag="ResMon" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A34D399" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSpeedTest}" Fill="{StaticResource IconGradEmerald}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Монитор ресурсов" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 9. Disk Management -->
                    <Button Click="BtnSnapin_Click" Tag="DiskMgmt" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Управление дисками" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 10. Services -->
                    <Button Click="BtnSnapin_Click" Tag="Services" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoServices}" Fill="{StaticResource IconGradAmber}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Службы (Services.msc)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 11. Network Connections -->
                    <Button Click="BtnSnapin_Click" Tag="NetworkConn" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Сетевые подключения" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 12. Power Options -->
                    <Button Click="BtnSnapin_Click" Tag="PowerCfg" Style="{StaticResource StormSecondaryButton}" Margin="4" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoPower}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Электропитание" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы по Инструментам Windows (FAQ)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSystemTools}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Что делают проверки SFC и DISM?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="SFC (System File Checker) сканирует защищенные системные DLL и восстанавливает поврежденные файлы. DISM (Deployment Image Servicing and Management) восстанавливает поврежденное хранилище компонентов Windows Component Store." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
