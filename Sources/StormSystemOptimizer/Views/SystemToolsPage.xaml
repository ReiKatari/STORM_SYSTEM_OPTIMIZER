<Page x:Class="StormSystemOptimizer.Views.SystemToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="System Tools">

    <Page.DataContext>
        <vm:SystemToolsViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Top Header -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSystemTools}" Fill="{StaticResource IconGradAmber}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Инструменты восстановления, глубокой оптимизации и оснастки" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Глубокая проверка целостности системных файлов, восстановление образа ОС, режим MSI для шины PCIe, тюнинг DirectStorage 1.2, очистка Standby памяти и быстрый доступ к системным оснасткам."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Статус: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ToolStatus}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Advanced Hardware & Memory Tweaks (MSI Mode, DirectStorage, Standby Purge, Snapshot) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Аппаратный тюнинг PCIe, DirectStorage и память ядра" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- MSI Mode -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AFB7185" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoGpu}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Режим MSI (Message Signaled Interrupts)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Перевод GPU и контроллеров USB в режим прерываний MSI для минимизации Input Lag." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            
                            <!-- Live Status Badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsMsiActive, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ Включено (Режим MSI активен)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsMsiActive, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ Отключено (Line-based режим)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Action Button -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsMsiActive, Converter={StaticResource InverseBoolToVisConverter}}"
                                    Command="{Binding ToggleMsiModeCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="⚡ Включить"
                                    Style="{StaticResource StormHeroButton}"
                                    Padding="14,6"/>
                            <Button Visibility="{Binding IsMsiActive, Converter={StaticResource BoolToVisConverter}}"
                                    Command="{Binding ToggleMsiModeCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="Отключить"
                                    Style="{StaticResource StormSecondaryButton}"
                                    Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DirectStorage 1.2 & NVMe BypassIO -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A34D399" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradEmerald}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Тюнинг DirectStorage 1.2 и BypassIO" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Оптимизация очередей Win32 IoRing и разгрузка шины ввода-вывода для игр." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            
                            <!-- Live Status Badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsDirectStorageActive, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ Настроено (BypassIO и IoRing активны)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsDirectStorageActive, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ Стандартный режим" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Action Button -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsDirectStorageActive, Converter={StaticResource InverseBoolToVisConverter}}"
                                    Command="{Binding ToggleDirectStorageCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="⚡ Включить"
                                    Style="{StaticResource StormHeroButton}"
                                    Padding="14,6"/>
                            <Button Visibility="{Binding IsDirectStorageActive, Converter={StaticResource BoolToVisConverter}}"
                                    Command="{Binding ToggleDirectStorageCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Content="Сбросить"
                                    Style="{StaticResource StormSecondaryButton}"
                                    Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Standby Memory Purge -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AC084FC" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoRam}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Очистка кэша Standby List ОЗУ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Мгновенное освобождение кэшированной памяти ожидания через NtSetSystemInformation." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Border Visibility="{Binding IsStandbyPurged, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="✓ Очищено (Память свободна)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>
                        <Button Command="{Binding PurgeStandbyMemoryCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Очистить" Style="{StaticResource StormSecondaryButton}" Padding="14,6" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Snapshot & Rollback -->
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A38BDF8" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource IconGradSky}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Снимок параметров (Snapshot и Rollback)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Резервный снимок критических параметров реестра перед тюнингом для быстрого отката." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Command="{Binding CreateSnapshotCommand}" IsEnabled="{Binding IsNotBusy}" Grid.Column="1" Content="Создать снимок" Style="{StaticResource StormSecondaryButton}" Padding="14,6" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Deep Kernel, Shell & Latency Tuning -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradEmerald}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Глубокий отклик ОС, игровой планировщик и Проводник" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Explorer Responsiveness -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A38BDF8" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource IconGradSky}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Отклик Проводника и изоляция процессов" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="MenuShowDelay=0, мгновенный отклик системных окон, защита от зависаний папок и отключение сетевого опроса." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsExplorerOptimized, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ Включено (Мгновенный отклик)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsExplorerOptimized, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ Стандартные задержки" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsExplorerOptimized, Converter={StaticResource InverseBoolToVisConverter}}" Command="{Binding ToggleExplorerResponsivenessCommand}" IsEnabled="{Binding IsNotBusy}" Content="⚡ Ускорить" Style="{StaticResource StormHeroButton}" Padding="14,6"/>
                            <Button Visibility="{Binding IsExplorerOptimized, Converter={StaticResource BoolToVisConverter}}" Command="{Binding ToggleExplorerResponsivenessCommand}" IsEnabled="{Binding IsNotBusy}" Content="Сбросить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Win32 Priority Separation -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AFBBF24" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradAmber}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Игровой квант ядра (Win32 Priority 0x1A)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Короткие переменные кванты времени планировщика ядра: наивысший приоритет фокуса активной игры." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsWin32PriorityOptimized, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ Включено (0x1A eSports Boost)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsWin32PriorityOptimized, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ Стандартный квант" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsWin32PriorityOptimized, Converter={StaticResource InverseBoolToVisConverter}}" Command="{Binding ToggleWin32PriorityCommand}" IsEnabled="{Binding IsNotBusy}" Content="⚡ Включить" Style="{StaticResource StormHeroButton}" Padding="14,6"/>
                            <Button Visibility="{Binding IsWin32PriorityOptimized, Converter={StaticResource BoolToVisConverter}}" Command="{Binding ToggleWin32PriorityCommand}" IsEnabled="{Binding IsNotBusy}" Content="Сбросить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MMCSS Gaming Optimization -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AFB7185" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoGamepad}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Планировщик MMCSS и Снятие троттлинга сети" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Выделение 100% CPU/GPU играм (SystemResponsiveness=0), полное отключение сетевого троттлинга Windows." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsMmcssOptimized, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ Включено (100% CPU/GPU для игр)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsMmcssOptimized, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ Стандартный MMCSS" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsMmcssOptimized, Converter={StaticResource InverseBoolToVisConverter}}" Command="{Binding ToggleMmcssCommand}" IsEnabled="{Binding IsNotBusy}" Content="⚡ Включить" Style="{StaticResource StormHeroButton}" Padding="14,6"/>
                            <Button Visibility="{Binding IsMmcssOptimized, Converter={StaticResource BoolToVisConverter}}" Command="{Binding ToggleMmcssCommand}" IsEnabled="{Binding IsNotBusy}" Content="Сбросить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Zero Startup Delay -->
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AC084FC" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Мгновенный автозапуск (Zero Startup Delay)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Устранение 10-секундной искусственной паузы Windows при старте системы для мгновенной готовности рабочего стола." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Visibility="{Binding IsZeroStartupDelayActive, Converter={StaticResource BoolToVisConverter}}" Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="✓ Включено (Задержка 0 мс)" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                                <Border Visibility="{Binding IsZeroStartupDelayActive, Converter={StaticResource InverseBoolToVisConverter}}" Background="#1A6B7280" BorderBrush="#374151" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="○ Стандартная задержка" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Visibility="{Binding IsZeroStartupDelayActive, Converter={StaticResource InverseBoolToVisConverter}}" Command="{Binding ToggleZeroStartupDelayCommand}" IsEnabled="{Binding IsNotBusy}" Content="⚡ Включить" Style="{StaticResource StormHeroButton}" Padding="14,6"/>
                            <Button Visibility="{Binding IsZeroStartupDelayActive, Converter={StaticResource BoolToVisConverter}}" Command="{Binding ToggleZeroStartupDelayCommand}" IsEnabled="{Binding IsNotBusy}" Content="Сбросить" Style="{StaticResource StormSecondaryButton}" Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shell Cache Rebuild -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
