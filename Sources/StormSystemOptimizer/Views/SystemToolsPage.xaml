<Page
    x:Class="StormSystemOptimizer.Views.SystemToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StormSystemOptimizer.Views"
    xmlns:vm="using:StormSystemOptimizer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Stretch" Margin="0,0,16,24">

            <!-- Header -->
            <Border Background="{ThemeResource StormCardGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE90F;" FontSize="20" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                        <TextBlock Text="Системные инструменты и оптимизаторы" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Специализированные утилиты для создания контрольных точек, оптимизации дисков и тонкой настройки Windows." FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Tools Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Restore Point -->
                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{ThemeResource AccentGlowBrush}" CornerRadius="8" Padding="8">
                                <FontIcon Glyph="&#xE777;" FontSize="18" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Точка восстановления Windows" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Создание снапшота реестра и системы" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Создает безопасную точку восстановления Windows перед внесением изменений." FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <Button Command="{x:Bind ViewModel.CreateRestorePointCommand}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Stretch">
                            <TextBlock Text="Создать точку восстановления" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 2. SSD TRIM -->
                <Border Grid.Row="0" Grid.Column="1" Margin="10,0,0,14" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{ThemeResource AccentGlowBrush}" CornerRadius="8" Padding="8">
                                <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{ThemeResource AccentSecondaryBrush}"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Оптимизация накопителей (TRIM)" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Очистка неиспользуемых блоков SSD" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Выполняет команду TRIM и оптимизацию томов NTFS для максимальной скорости записи." FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <Button Command="{x:Bind ViewModel.RunSsdTrimCommand}"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Stretch">
                            <TextBlock Text="Запустить TRIM для диска C:" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 3. Ultimate Power Plan -->
                <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{ThemeResource AccentGlowBrush}" CornerRadius="8" Padding="8">
                                <FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Ultimate Performance План" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Схема питания максимальной производительности" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Разблокирует скрытый профиль энергопотребления для устранения микрофризов в играх." FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <Button Command="{x:Bind ViewModel.ActivateUltimatePowerPlanCommand}"
                                Background="{ThemeResource StormHeroGradient}" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="8" Padding="14,8" HorizontalAlignment="Stretch">
                            <TextBlock Text="Активировать Ultimate Power" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 4. UI Responsiveness -->
                <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="{ThemeResource AccentGlowBrush}" CornerRadius="8" Padding="8">
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentSecondaryBrush}"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Ускорение отклика интерфейса" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Снижение задержки MenuShowDelay до 10 мс" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Убирает 400 мс задержку открытия контекстных меню и окон в Windows." FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <Button Command="{x:Bind ViewModel.OptimizeVisualLatencyCommand}"
                                Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="8" Padding="14,8" HorizontalAlignment="Stretch">
                            <TextBlock Text="Ускорить отклик меню" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Status Banner -->
            <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE90F;" FontSize="14" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.ToolStatus, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
