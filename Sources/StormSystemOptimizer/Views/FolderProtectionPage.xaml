<Page x:Class="StormSystemOptimizer.Views.FolderProtectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Скрытие и защита папок"
      AllowDrop="True"
      Drop="Page_Drop"
      DragOver="Page_DragOver">

    <Page.DataContext>
        <vm:FolderProtectionViewModel/>
    </Page.DataContext>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="20,20,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoFolderLock}" Fill="{StaticResource IconGradAmber}" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Скрытие и защита папок" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="3 режима защиты: скрытие от проводника, блокировка доступа паролем через NTFS ACL без скрытия, или максимальная защита со скрытием и шифрованием."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding VaultStats}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add Folder & Protection Setup Card (with Drag & Drop target) -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="20,0,20,12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Добавить папку в защищенный сейф (Поддерживается Drag and Drop)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <Border Grid.Column="1" Background="#1A00D2FF" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Перетащите папку сюда" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="Укажите или перетащите путь к папке (например, D:\Личные_Документы)..."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SelectedFolderPath, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <TextBox Text="{Binding SelectedFolderPath, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Command="{Binding BrowseFolderCommand}" Style="{StaticResource StormSecondaryButton}" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSearch}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Обзор..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Protection Modes & Password Row -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Режим:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- Mode ComboBox -->
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedModeIndex}" Margin="0,0,14,0" Height="36" VerticalAlignment="Center">
                        <ComboBoxItem Content="👁️  Только Скрытие (Stealth)"/>
                        <ComboBoxItem Content="🔒  Только Пароль (Блокировка доступа)"/>
                        <ComboBoxItem Content="🛡️  Скрыто и Запаролено (Max Security)"/>
                    </ComboBox>

                    <!-- Password input with Watermark -->
                    <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,14,0" Height="36" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Задайте пароль для блокировки доступа..."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding PasswordInput, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <TextBox Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Protect Button -->
                    <Button Grid.Column="3" Command="{Binding ProtectSelectedFolderCommand}" Style="{StaticResource StormHeroButton}" Padding="18,8" Height="36" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoLock}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Защитить папку" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Protected Folders List / Empty Guide State -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="20,0,20,12">
            <Grid>
                <!-- Empty State Message -->
                <Border Visibility="{Binding IsVaultEmpty, Converter={StaticResource BoolToVisConverter}}"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="30"
                        Margin="10"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="600">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="20" Width="48" Height="48" Margin="0,0,0,14" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoFolderLock}" Fill="{StaticResource IconGradAmber}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Сейф папок пуст" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Перетащите любую секретную или важную папку с диска в это окно, либо нажмите кнопку «Обзор...», выберите желаемый режим безопасности и задайте пароль для полной защиты от посторонних глаз."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>
                    </StackPanel>
                </Border>

                <!-- Items List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ProtectedFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Folder Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding FolderName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding FolderPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ModeTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Size & Files -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SizeFormatted}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0} файлов'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Unlock Password input -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                                <TextBox Text="{Binding DataContext.UnlockPasswordInput, RelativeSource={RelativeSource AncestorType=ItemsControl}, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" ToolTip="Введите пароль для разблокировки"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <WrapPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="8,6"
                                                    Margin="0,0,6,4"
                                                    ToolTip="Открыть в проводнике Windows">
                                                <TextBlock Text="Проводник" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.UnlockFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Открыть" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.LockFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="10,6"
                                                    Margin="0,0,6,4">
                                                <TextBlock Text="Заблокировать" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.RemoveProtectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormDangerButton}"
                                                    Padding="8,6"
                                                    Margin="0,0,0,4"
                                                    ToolTip="Снять защиту навсегда">
                                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- FAQ Section with Gradient Vector Icons -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Частые вопросы по Скрытию и Защите папок (FAQ)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoLock}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="В чем разница между режимами Скрытия и Пароля?" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <TextBlock Text="«Только Скрытие» применяет системные атрибуты Hidden+System, делая папку невидимой в Проводнике. «Только Пароль» блокирует доступ на уровне дескрипторов безопасности NTFS ACL (папка видна, но войти в нее невозможно). «Максимальный» сочетает скрытие и блокировку прав." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Status Bottom Banner -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="20,0,20,20">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
