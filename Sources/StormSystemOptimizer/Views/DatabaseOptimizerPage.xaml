<Page x:Class="StormSystemOptimizer.Views.DatabaseOptimizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Database Optimizer">

    <Page.DataContext>
        <vm:DatabaseOptimizerViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDatabase}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Оптимизация и дефрагментация баз данных SQLite" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Компактизация (VACUUM) и перестроение индексов (REINDEX) для баз данных Chromium, Edge, Firefox, Telegram, Discord, Steam и VS Code для мгновенного отклика."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ScanCommand}" Style="{DynamicResource StormSecondaryButton}" Padding="14,10" Margin="0,0,8,4">
                            <TextBlock Text="Сканировать" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding OptimizeAllCommand}" Style="{DynamicResource StormHeroButton}" Padding="16,10" Margin="0,0,0,4">
                            <TextBlock Text="ОПТИМИЗИРОВАТЬ ВСЕ БАЗЫ" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Metrics Summary Grid -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="ОБНАРУЖЕНО БАЗ ДАННЫХ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TotalFoundCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="ОБЩИЙ ОБЪЕМ НА ДИСКЕ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TotalOriginalSize}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="СЭКОНОМЛЕНО МЕСТА" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TotalSavedSize}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Databases List Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Обнаруженные базы данных SQLite в системе" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="460">
                        <DataGrid ItemsSource="{Binding Databases}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  VerticalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  RowBackground="Transparent"
                                  HeadersVisibility="Column"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Приложение" Binding="{Binding AppName}" Width="150"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="130"/>
                                <DataGridTextColumn Header="Файл базы данных" Binding="{Binding FilePath}" Width="3*"/>
                                <DataGridTextColumn Header="Размер" Binding="{Binding OriginalSizeFormatted}" Width="110"/>
                                <DataGridTemplateColumn Header="Статус" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding StatusBadgeColor}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
