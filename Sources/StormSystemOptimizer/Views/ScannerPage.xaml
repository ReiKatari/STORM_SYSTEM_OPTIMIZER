<Page
    x:Class="StormSystemOptimizer.Views.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StormSystemOptimizer.Views"
    xmlns:models="using:StormSystemOptimizer.Models"
    xmlns:vm="using:StormSystemOptimizer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Border Grid.Row="0" Background="{ThemeResource StormCardGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                        <TextBlock Text="Глубокое сканирование всей системы" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.StartScanCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotScanning, Mode=OneWay}"
                            Background="{ThemeResource AccentPrimaryBrush}" Foreground="#000000" FontWeight="Bold" CornerRadius="8" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="14"/>
                            <TextBlock Text="Начать сканирование"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.FixSafeOnlyCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotFixing, Mode=OneWay}"
                            Background="{ThemeResource BadgeSafeBgBrush}" BorderBrush="{ThemeResource BadgeSafeTextBrush}" BorderThickness="1"
                            Foreground="{ThemeResource BadgeSafeTextBrush}" FontWeight="Bold" CornerRadius="8" Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="14"/>
                            <TextBlock Text="Исправить 100% безопасные"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.FixSelectedCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotFixing, Mode=OneWay}"
                            Background="{ThemeResource StormHeroGradient}" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="8" Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14"/>
                            <TextBlock Text="Оптимизировать выбранное"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats Bar & Progress -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Stats summary pills -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
                <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Найдено проблем:" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.IssuesCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource BadgeSafeBgBrush}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Безопасных:" FontSize="12" Foreground="{ThemeResource BadgeSafeTextBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.SafeIssuesCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource BadgeSafeTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource BadgeRecommendedBgBrush}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Рекомендуемых:" FontSize="12" Foreground="{ThemeResource BadgeRecommendedTextBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.RecommendedCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource BadgeRecommendedTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource AccentGlowBrush}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Освобождаемое место:" FontSize="12" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalReclaimableText, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Select Helpers -->
                <Button Command="{x:Bind ViewModel.SelectAllCommand}" Content="Выбрать все" Background="Transparent" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" Padding="8,4"/>
                <Button Command="{x:Bind ViewModel.DeselectAllCommand}" Content="Снять выбор" Background="Transparent" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11" Padding="8,4"/>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentPrimaryBrush}"/>
        </Grid>

        <!-- Issues List View -->
        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.FilteredIssues, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="0,0,8,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:OptimizationItem">
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Checkbox -->
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsNotFixed, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <!-- Title, Description & Details -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    
                                    <!-- Risk Level Badge -->
                                    <Border Background="{ThemeResource BadgeSafeBgBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RiskBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource BadgeSafeTextBrush}"/>
                                    </Border>

                                    <!-- Category Pill -->
                                    <Border Background="{ThemeResource CardHoverBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind CategoryName}" FontSize="9" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                
                                <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind FormattedDetails}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}"/>
                            </StackPanel>

                            <!-- Reclaimable Space -->
                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="16,0,20,0"/>

                            <!-- Status Badge -->
                            <Border Grid.Column="3" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                                    Background="{ThemeResource CardHoverBrush}">
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
