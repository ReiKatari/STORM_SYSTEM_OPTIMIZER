<Page x:Class="StormSystemOptimizer.Views.ScannerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      xmlns:ctrl="clr-namespace:StormSystemOptimizer.Controls"
      Title="Scanner">

    <Page.DataContext>
        <vm:ScannerViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Custom Cyber Square Checkbox with Solid Neon Fill -->
        <Style x:Key="CyberSquareCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder" Width="20" Height="20" CornerRadius="5" Background="#111827" BorderBrush="#3300D2FF" BorderThickness="1.5">
                            <Rectangle x:Name="InnerBox" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#1A00D2FF"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="InnerBox" Property="Fill" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header & ASC Dynamic Scan Hero Card -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Глубокое сканирование и оптимизация" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Интеллектуальный анализ служб, реестра, сетевого стека, шейдеров, системного мусора и настроек безопасности по стандартам IObit и Ashampoo."
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Stats badges -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A00D2FF" CornerRadius="3" Padding="3" Margin="0,0,6,0">
                                        <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Найдено проблем: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding IssuesCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1AC084FC" CornerRadius="3" Padding="3" Margin="0,0,6,0">
                                        <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Освобождаемый объем: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalReclaimableText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Selection Buttons Bar -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SelectAllCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A00D2FF" CornerRadius="3" Padding="3" Margin="0,0,6,0">
                                        <Path Data="{StaticResource GeoCheck}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Выбрать всё" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DeselectAllCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A6B7280" CornerRadius="3" Padding="3" Margin="0,0,6,0">
                                        <Rectangle Width="8" Height="8" Fill="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Text="Снять выбор" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Dynamic Circular Action Button (SCAN -> SCANNING -> FIX) -->
                    <ctrl:AscScanButtonControl Grid.Column="1"
                                               IsScanning="{Binding IsScanning}"
                                               Progress="{Binding ScanProgress}"
                                               StatusStepText="{Binding CurrentScanCategory}"
                                               IssuesCount="{Binding IssuesCount}"
                                               ScanCommand="{Binding StartScanCommand}"
                                               FixCommand="{Binding FixSelectedCommand}"
                                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Comparative Impact Banner -->
            <ctrl:ComparativeImpactControl Grid.Row="1" Icon="🧹" MetricTitle="Очистка системного мусора и кэшей" MetricSubtitle="Глубокое сканирование по стандартам Ashampoo и IObit" BeforeValue="0 ГБ" AfterValue="4.8 ГБ" BadgeText="+4.8 ГБ свободно" Margin="0,0,0,14"/>

            <!-- Live Scan Progress Bar -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentScanCategory}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ScanProgress, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding ScanProgress}" Maximum="100" Height="8" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ScanStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Issues List -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <ListBox ItemsSource="{Binding ScanItems}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Neon Solid Square CheckBox Without Checkmark Glyph -->
                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource CyberSquareCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0"/>

                                    <!-- Details with TextWrapping -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding FormattedDetails}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Объем" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Category Badge with distinct high-contrast colors -->
                                    <Border Grid.Column="3" Background="{Binding CategoryBgColor}" BorderBrush="{Binding CategoryTextColor}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="Bold" Foreground="{Binding CategoryTextColor}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Safe Optimization Note -->
            <Border Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="⚡ Все оптимизации проверены и гарантируют полную безопасность и целостность вашей операционной системы Windows."
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Grid.Row="5" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы по Глубокому сканированию (FAQ)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Не удалятся ли важные документы или пароли в браузерах?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Нет! Очистка затрагивает исключительно временные кэши (.tmp, .dmp), шейдеры DirectX/Vulkan/NVIDIA/AMD и журналы ошибок. Ваши личные файлы, вкладки, сохраненные пароли и закладки браузеров остаются в абсолютной сохранности." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoShield}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Как часто рекомендуется проводить глубокое сканирование?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Оптимально выполнять сканирование один раз в неделю или после масштабных обновлений Windows и игр. Это предотвращает фрагментацию кэшей и накопление мусора на системном диске." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
