<Page x:Class="StormSystemOptimizer.Views.DisksPage"
      x:Name="RootDisksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Disks">

    <Page.DataContext>
        <vm:DisksViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" CanContentScroll="False">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Top Header & Global Actions -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Диагностика накопителей и служба дефрагментации" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Детальная информация о каждом накопителе (HDD, SSD, NVMe), проверка состояния, анализ уровня фрагментации, TRIM-оптимизация и глубокая дефрагментация."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left" MinHeight="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Статус: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Global Actions -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OptimizeAllDrivesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormHeroButton}"
                                Margin="0,0,10,4"
                                Padding="16,10">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoDashboard}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Оптимизировать все диски" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding LoadDrivesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormSecondaryButton}"
                                Margin="0,0,0,4"
                                Padding="12,10">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Обновить" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Disks List Header & Filter Tabs -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#1A34D399" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Накопители и тома" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- View Mode Switcher (Physical vs Partition) -->
                <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Общий (Физические диски)" IsChecked="{Binding IsPhysicalView}" Command="{Binding SetViewModeCommand}" CommandParameter="Physical" Style="{StaticResource NavRadioButtonStyle}" Padding="10,4" Margin="0,0,4,0"/>
                        <RadioButton Content="По разделам (Тома)" IsChecked="{Binding IsPartitionView}" Command="{Binding SetViewModeCommand}" CommandParameter="Partition" Style="{StaticResource NavRadioButtonStyle}" Padding="10,4"/>
                    </StackPanel>
                </Border>

                <!-- Filter Tabs -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding FilterDrivesCommand}" CommandParameter="Все" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4">
                        <TextBlock Text="Все" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding FilterDrivesCommand}" CommandParameter="SSD" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4">
                        <TextBlock Text="SSD / NVMe" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding FilterDrivesCommand}" CommandParameter="ReFS" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,6,4">
                        <TextBlock Text="ReFS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding FilterDrivesCommand}" CommandParameter="HDD" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,0,4">
                        <TextBlock Text="HDD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- 1. PHYSICAL DRIVES VIEW (DEFAULT) -->
            <ItemsControl ItemsSource="{Binding FilteredPhysicalDrives}" Visibility="{Binding IsPhysicalView, Converter={StaticResource BoolToVisConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Top Row: Model, Type & Health Badge -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Model}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                            <TextBlock Text="Тип: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DriveType}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text=" • Интерфейс: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding InterfaceType}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" • Температура: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                            <Border Background="#1A34D399" CornerRadius="3" Padding="4,1" Margin="2,0,0,0">
                                                <TextBlock Text="{Binding Temperature}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </WrapPanel>

                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏳ Эксплуатация: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding OperatingTimeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" • 📅 Серия / Выпуск: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding ReleaseDateText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Right Health Status -->
                                    <Border Grid.Column="1" Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusColor}" BorderThickness="1.5" CornerRadius="6" Padding="12,6" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Состояние: " FontSize="11.5" Foreground="{Binding StatusColor}"/>
                                            <TextBlock Text="{Binding HealthStatus}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Capacity Bar for Physical Drive -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FormattedFree}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" из " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding FormattedTotal}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PartitionsCountText, StringFormat=' ({0})'}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UsedPercentText, StringFormat='Занято: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding UsedPercentage}" Maximum="100" Height="8" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Partitions Breakdown List -->
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Разделы и тома на данном накопителе:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Volumes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Letter & Label -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <Border Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding VolumeLetter}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding VolumeLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Capacity & Progress -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <Grid Margin="0,0,0,3">
                                                                    <TextBlock Text="{Binding SpaceUsageSummary}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    <TextBlock Text="{Binding FileSystem, StringFormat='ФС: {0}'}" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                                <ProgressBar Value="{Binding UsedPercentage}" Maximum="100" Height="4" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
                                                            </StackPanel>

                                                            <!-- Fragmentation -->
                                                            <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FragmentationSummary}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>

                                                            <!-- Action Button -->
                                                            <Button Grid.Column="3"
                                                                    Command="{Binding ElementName=RootDisksPage, Path=DataContext.DefragDriveCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource StormSecondaryButton}"
                                                                    Padding="10,4"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding OptimizationActionName}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 2. PARTITIONS / VOLUMES VIEW -->
            <ItemsControl ItemsSource="{Binding FilteredDrives}" Visibility="{Binding IsPartitionView, Converter={StaticResource BoolToVisConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Volume Letter, Model, Drive Type & Status Badges -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Section: Letter, Model & Properties -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Volume Letter Badge -->
                                            <Border Grid.Column="0" Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VolumeLetter}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            </Border>

                                            <!-- Drive Model with wrapping -->
                                            <TextBlock Grid.Column="1" Text="{Binding Model}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>

                                        <!-- Subtitle Properties -->
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                            <TextBlock Text="Тип: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DriveType}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • Файловая система: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileSystem}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • Интерфейс: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding InterfaceType}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • Температура: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <Border Background="#1A34D399" CornerRadius="3" Padding="4,1" Margin="2,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Temperature}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Lifespan & Release Date Info -->
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏳ Эксплуатация: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OperatingTimeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • 📅 Серия / Выпуск: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ReleaseDateText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Status Badges on Right -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <!-- Health Badge -->
                                        <Border Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusColor}" BorderThickness="1.5" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Состояние: " FontSize="11" Foreground="{Binding StatusColor}"/>
                                                <TextBlock Text="{Binding HealthStatus}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Fragmentation Badge -->
                                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Фрагментация: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FragmentationSummary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Middle Row: Capacity ProgressBar & Free Space info -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Свободно: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding FreeSpaceText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" из " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TotalSizeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UsedPercentText, StringFormat='Занято: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ProgressBar Value="{Binding UsedPercentage}" Maximum="100" Height="8" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Live In-Progress Operation Bar (Visible during Analysis/Defrag) -->
                                <Border Grid.Row="2" Visibility="{Binding IsRunningOperation, Converter={StaticResource BoolToVisConverter}}"
                                        Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding CurrentOperationStatus}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text="{Binding OperationProgress, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding OperationProgress}" Maximum="100" Height="5" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Detailed Analysis Report Block (Visible when HasAnalysisReport is True) -->
                                <Border Grid.Row="3" Visibility="{Binding HasAnalysisReport, Converter={StaticResource BoolToVisConverter}}"
                                        Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource AccentGlowBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="Детальный отчет анализа файловой системы и секторов" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <UniformGrid Columns="4" Margin="0,0,0,8">
                                            <!-- Cluster Size -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Размер кластера" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding ClusterSizeText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Fragmented Files -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="4,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Фрагм. файлов" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding FormattedFragmentedFiles}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Total Fragments -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="4,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="Всего фрагментов" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding FormattedTotalFragments}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Largest Block -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8,6" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Крупный блок" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding LargestFreeBlockText}" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <TextBlock Text="{Binding AnalysisRecommendation, StringFormat='💡 Рекомендация: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bottom Row: Action Buttons for this exact drive item -->
                                <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Clean Junk Button -->
                                    <Button Command="{Binding ElementName=RootDisksPage, Path=DataContext.CleanDriveJunkCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsRunningOperation, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource StormSecondaryButton}"
                                            Margin="0,0,8,4"
                                            Padding="12,7">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1AFB7185" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                                <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Очистить мусор" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Analyze button -->
                                    <Button Command="{Binding ElementName=RootDisksPage, Path=DataContext.AnalyzeDriveCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsRunningOperation, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource StormSecondaryButton}"
                                            Margin="0,0,8,4"
                                            Padding="14,7">
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Анализ тома" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Optimize/Defrag button -->
                                    <Button Command="{Binding ElementName=RootDisksPage, Path=DataContext.DefragDriveCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsRunningOperation, Converter={StaticResource InverseBoolConverter}}"
                                            Style="{StaticResource StormHeroButton}"
                                            Padding="16,8">
                                        <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoDashboard}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding OptimizationActionName, FallbackValue='Оптимизировать'}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы по Накопителям и Оптимизации (FAQ)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Что такое DirectStorage 1.2 и BypassIO?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="DirectStorage 1.2 в связке с BypassIO позволяет современным играм распаковывать и загружать текстуры и 3D-ассеты с NVMe SSD напрямую в видеопамять (VRAM) видеокарты, минуя узкие места центрального процессора. Это устраняет подгрузку текстур на лету и ускоряет загрузки в разы." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="В чем разница между оптимизацией SSD и HDD?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Для SSD выполняется аппаратная команда TRIM (очистка неиспользуемых блоков ячеек памяти NAND для сохранения высокой скорости записи). Для классических жестких дисков (HDD) проводится глубокая дефрагментация секторов для сокращения перемещений считывающей головки." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
