<Page x:Class="StormSystemOptimizer.Views.DisksPage"
      x:Name="RootDisksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Disks">

    <Page.DataContext>
        <vm:DisksViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Top Header & Global Actions -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Диагностика накопителей и служба дефрагментации" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Детальная информация о каждом накопителе (HDD, SSD, NVMe), проверка состояния, анализ фрагментации, TRIM-оптимизация и глубокая дефрагментация."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Статус: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Global Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OptimizeAllDrivesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Content="⚡ Оптимизировать все диски"
                                Style="{StaticResource StormHeroButton}"
                                Margin="0,0,10,0"/>

                        <Button Command="{Binding LoadDrivesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Content="↺ Обновить"
                                Style="{StaticResource StormSecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Disks List -->
            <TextBlock Text="💾 Физические накопители и логические тома" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Volume Letter, Model, Drive Type & Status Badges -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Volume Letter Badge -->
                                            <Border Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding VolumeLetter}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            </Border>

                                            <!-- Volume Label or Model -->
                                            <TextBlock Text="{Binding Model}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Тип: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DriveType}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text=" • Файловая система: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding FileSystem}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" • Интерфейс: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding InterfaceType}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" • Температура: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Temperature}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status Badges on Right with high-contrast text and border -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Health Badge -->
                                        <Border Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusColor}" BorderThickness="1.5" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Состояние: " FontSize="11" Foreground="{Binding StatusColor}"/>
                                                <TextBlock Text="{Binding HealthStatus}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Fragmentation Badge -->
                                        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Фрагментация: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FragmentationSummary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Middle Row: Capacity ProgressBar & Free Space info -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Свободно: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding FreeSpaceText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" из " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TotalSizeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UsedPercentText, StringFormat='Занято: {0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <ProgressBar Value="{Binding UsedPercentage}" Maximum="100" Height="8" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Bottom Row: Action Buttons for this drive -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Analyze button -->
                                    <Button Command="{Binding ElementName=RootDisksPage, Path=DataContext.AnalyzeDriveCommand}"
                                            CommandParameter="{Binding VolumeLetter}"
                                            Content="🔍 Анализ тома"
                                            Style="{StaticResource StormSecondaryButton}"
                                            Margin="0,0,8,0"/>

                                    <!-- Optimize/Defrag button -->
                                    <Button Command="{Binding ElementName=RootDisksPage, Path=DataContext.DefragDriveCommand}"
                                            CommandParameter="{Binding VolumeLetter}"
                                            Content="{Binding OptimizationActionName, FallbackValue='⚡ Оптимизировать'}"
                                            Style="{StaticResource StormHeroButton}"
                                            Padding="16,8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
