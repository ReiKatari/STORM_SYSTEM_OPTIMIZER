<Page x:Class="StormSystemOptimizer.Views.DefragPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Дефрагментация и TRIM дисков">

    <Page.DataContext>
        <vm:DefragViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Дефрагментация и TRIM дисков" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Профессиональный модуль обслуживания накопителей. Автоматическое распознавание типа диска: аппаратный TRIM для SSD/NVMe без износа флэш-памяти и глубокая дефрагментация кластеров для магнитных HDD."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding AnalyzeDriveCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Анализ тома" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DefragOrTrimCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSpeedTest}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Оптимизировать" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Drive Selector Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Выбор накопителя:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Drives}"
                              SelectedItem="{Binding SelectedDrive}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch"
                              Height="34"
                              Margin="0,0,16,0"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource AppBackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Режим: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ActiveMode}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Metrics Summary Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Фрагментация тома" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SelectedDrive.StatusText}" FontSize="16" FontWeight="Bold" Foreground="{Binding SelectedDrive.StatusColor}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Тип накопителя" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding SelectedDrive.DriveType}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Размер кластера" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ClusterSize}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Крупнейший блок" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LargestFreeBlock}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 2D Sector Cluster Map -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Интерактивная карта кластеров тома" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Recommendation}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Progress Bar (Visible when busy) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="220" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0"/>
                            <TextBlock Text="{Binding Progress, StringFormat='{}{0:F0}% завершено'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Cluster Grid: 200 blocks in 20 columns -->
                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <ItemsControl ItemsSource="{Binding ClusterBlocks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="20" Rows="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="1.5" Height="14" CornerRadius="2" ToolTip="{Binding ToolTip}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Legend -->
                    <WrapPanel Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#A855F7" Margin="0,0,6,0"/>
                            <TextBlock Text="Системная область / MFT" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#38BDF8" Margin="0,0,6,0"/>
                            <TextBlock Text="Непрерывные данные" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#EF4444" Margin="0,0,6,0"/>
                            <TextBlock Text="Фрагментированные файлы" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#1E293B" Margin="0,0,6,0"/>
                            <TextBlock Text="Свободное пространство" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" Margin="0,0,6,0"/>
                            <TextBlock Text="Оптимизировано / TRIM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Advanced Actions Suite Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Специализированные режимы оптимизации" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button Command="{Binding DeepDefragCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradSky}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Глубокая консолидация свободного места" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding BootDefragCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPower}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Загрузочные файлы ядра (defrag /B)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LoadDrivesCommand}" IsEnabled="{Binding IsNotBusy}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Пересканировать диски" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Output Log Terminal Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoTerminal}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Подробный журнал операций дефрагментации" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding CopyLogCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoCopy}" Fill="{StaticResource AccentPrimaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Копировать" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearLogCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoClean}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Очистить" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Background="#0A0B10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Height="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding RawLog}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11.5"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
