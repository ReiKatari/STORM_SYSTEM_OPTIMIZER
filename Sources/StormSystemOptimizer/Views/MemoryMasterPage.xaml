<Page x:Class="StormSystemOptimizer.Views.MemoryMasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Управление памятью и файлом подкачки">

    <Page.DataContext>
        <vm:MemoryMasterViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Header Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoPagefile}" Fill="{StaticResource IconGradPurple}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Управление памятью и файлом подкачки" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Глубокая очистка списков ожидания Standby List, сброс рабочих наборов EmptyWorkingSet, включение LargeSystemCache и гибкое ручное управление размером файла подкачки (pagefile.sys)."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding FlushMemoryCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,9" Margin="0,0,8,4">
                            <TextBlock Text="Сбросить Standby List" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding ApplyMemoryTweaksCommand}" Style="{StaticResource StormHeroButton}" Padding="18,10" Margin="0,0,0,4">
                            <TextBlock Text="Применить тюнинг ОЗУ" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Pagefile Customizer Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Управление файлом подкачки Windows (Pagefile.sys)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Active Configuration Badge -->
                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Текущее состояние:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentPagefileSetting}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Quick Presets -->
                    <TextBlock Text="Быстрые готовые конфигурации в один клик:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Command="{Binding SetPresetCommand}" CommandParameter="gaming" Style="{StaticResource StormSecondaryButton}" Padding="12,6" Margin="0,0,8,6">
                            <TextBlock Text="Игровой (4 096 — 8 192 МБ)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding SetPresetCommand}" CommandParameter="fixed8gb" Style="{StaticResource StormSecondaryButton}" Padding="12,6" Margin="0,0,8,6">
                            <TextBlock Text="Киберспорт 8 ГБ (8 192 МБ фикс.)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding SetPresetCommand}" CommandParameter="auto" Style="{StaticResource StormSecondaryButton}" Padding="12,6" Margin="0,0,8,6">
                            <TextBlock Text="Авто-выбор Windows" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding SetPresetCommand}" CommandParameter="disable" Style="{StaticResource StormSecondaryButton}" Padding="12,6" Margin="0,0,8,6">
                            <TextBlock Text="Отключить pagefile" FontSize="11.5" FontWeight="SemiBold" Foreground="#EF4444"/>
                        </Button>
                    </WrapPanel>

                    <!-- Manual Controls -->
                    <TextBlock Text="Ручная настройка параметров файла подкачки:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Drive Selector -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock Text="Целевой накопитель:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="38" Padding="8,2" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding AvailableDrives}"
                                          SelectedItem="{Binding PagefileDrive}"
                                          Text="{Binding PagefileDrive}"
                                          IsEditable="True"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="12.5"
                                          VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Initial Size -->
                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock Text="Исходный размер (МБ):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0" VerticalAlignment="Center">
                                <TextBox Text="{Binding CustomPagefileInitialMbText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="13"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Max Size -->
                        <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Top">
                            <TextBlock Text="Максимальный размер (МБ):" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0" VerticalAlignment="Center">
                                <TextBox Text="{Binding CustomPagefileMaxMbText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="13"
                                         VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <WrapPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,0">
                            <Button Command="{Binding ApplyCustomPagefileCommand}" Style="{StaticResource StormHeroButton}" Height="38" Padding="16,0" Margin="0,0,8,0">
                                <TextBlock Text="Задать размер" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </Button>
                            <Button Command="{Binding ApplySystemManagedPagefileCommand}" Style="{StaticResource StormSecondaryButton}" Height="38" Padding="14,0">
                                <TextBlock Text="Авто-выбор" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Tweak Options -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Параметры управления системным кэшем и пулами памяти" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <CheckBox IsChecked="{Binding EnableLargeSystemCache}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Включить LargeSystemCache и запретить выгрузку исполнительных компонентов ядра (DisablePagingExecutive = 1)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Удерживает критически важные драйверы и ядро NT в быстрой физической памяти RAM без сброса на SSD." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding OptimizePools}" Margin="0,0,0,14">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Оптимизация пулов памяти (PoolUsageMaximum = 60%, NonPagedPoolSize)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Предотвращает фрагментацию пулов памяти и утечки при интенсивных игровых сессиях." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ClearPagefileAtShutdown}" Margin="0,0,0,4">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Очищать файл подкачки при завершении работы (ClearPageFileAtShutdown = 1)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="Заполняет pagefile нулями перед выключением ПК для обеспечения максимальной конфиденциальности." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
