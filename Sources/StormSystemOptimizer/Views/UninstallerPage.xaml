<Page x:Class="StormSystemOptimizer.Views.UninstallerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="850" d:DesignWidth="1100"
      Title="Удаление программ">

    <Page.DataContext>
        <vm:UninstallerViewModel/>
    </Page.DataContext>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="20,20,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoUninstaller}" Fill="{StaticResource IconGradRose}" Width="16" Height="16" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Деинсталлятор и менеджер установленных программ" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Полное удаление классических программ, игр Steam и приложений Windows Store с глубокой зачисткой скрытых остатков в реестре и AppData."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding StatsSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RemoveEdgeCommand}" Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,4">
                        <TextBlock Text="Удалить встроенный браузер" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding RemoveOneDriveCommand}" Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,4">
                        <TextBlock Text="Удалить облачное хранилище" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding CleanComponentStoreCommand}" Style="{StaticResource StormSecondaryButton}" Padding="10,6" Margin="0,0,6,4">
                        <TextBlock Text="Очистить хранилище компонентов" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding LoadAppsCommand}" Style="{StaticResource StormHeroButton}" Padding="14,8" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoScanner}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Сканировать" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource GeoSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="4,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Categories Tabs -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="Все" IsChecked="True" Style="{StaticResource NavRadioButtonStyle}" Click="FilterAll_Click" Margin="0,0,6,2" Padding="10,5"/>
                    <RadioButton Content="Игры" Style="{StaticResource NavRadioButtonStyle}" Click="FilterGames_Click" Margin="0,0,6,2" Padding="10,5"/>
                    <RadioButton Content="Программы" Style="{StaticResource NavRadioButtonStyle}" Click="FilterApps_Click" Margin="0,0,6,2" Padding="10,5"/>
                    <RadioButton Content="Store" Style="{StaticResource NavRadioButtonStyle}" Click="FilterStore_Click" Margin="0,0,6,2" Padding="10,5"/>
                </WrapPanel>

                <!-- Sorting Section -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сортировка: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Command="{Binding SetSortCommand}" CommandParameter="Размер ↓" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,4,0">
                        <TextBlock Text="Размер ↓" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding SetSortCommand}" CommandParameter="Размер ↑" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,4,0">
                        <TextBlock Text="Размер ↑" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding SetSortCommand}" CommandParameter="Имя (А-Я)" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,4,0">
                        <TextBlock Text="Имя" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Command="{Binding SetSortCommand}" CommandParameter="Дата" Style="{StaticResource StormSecondaryButton}" Padding="8,4">
                        <TextBlock Text="Дата" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Apps List -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="20,0,20,12">
            <Grid>
                <!-- Items list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DisplayApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Name & Publisher & Residuals -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeColor}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppType}" FontSize="10" FontWeight="Bold" Foreground="{Binding TypeBadgeColor}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayVersion}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <TextBlock Text="{Binding ResidualStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Size -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding InstallDate}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Residual Quick Actions -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Button Command="{Binding DataContext.ScanAppResidualsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="8,5"
                                                    Margin="0,0,0,4">
                                                <TextBlock Text="Поиск следов" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.CleanResidualsOnlyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Padding="8,4">
                                                <TextBlock Text="Удалить хвосты" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Hero Action: Deep Uninstall -->
                                        <Button Grid.Column="3"
                                                Command="{Binding DataContext.DeepUninstallAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource StormDangerButton}"
                                                Padding="14,8"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoClean}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                                <TextBlock Text="Удалить полностью" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Animated Loading Overlay -->
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                      Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource StormCircularLoadingSpinner}" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="Анализ реестра 64-bit/32-bit, библиотек Steam и приложений Store..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- FAQ Section with Gradient Vector Icons -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="20,0,20,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Частые вопросы по Удалению программ (FAQ)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Как работает глубокое удаление остаточных следов?" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <TextBlock Text="После завершения штатного деинсталлятора STORM сканирует реестр (HKCU/HKLM Software), скрытые папки AppData, ProgramData, временные каталоги и оставшиеся ярлыки, полностью удаляя мусор без повреждения Windows." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Status Bottom Banner -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="20,0,20,20">
            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
