<Page x:Class="StormSystemOptimizer.Views.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      xmlns:ctrl="clr-namespace:StormSystemOptimizer.Controls"
      Title="Processes">

    <Page.DataContext>
        <vm:ProcessesViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Stats -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A34D399" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoProcesses}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Глубокий анализ и менеджер процессов" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Детальное исследование процессов, определение нагрузки на память, назначение и рекомендации по безопасному завершению."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Stats badges -->
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A00D2FF" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                        <Path Data="{StaticResource GeoProcesses}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Всего процессов: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalProcessesCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1AC084FC" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                        <Path Data="{StaticResource GeoRam}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Занято ОЗУ: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding TotalMemoryText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A10B981" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                        <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradEmerald}" Width="10" Height="10" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Можно освободить: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SafeReclaimableText}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                        <Button Command="{Binding KillAllSafeBackgroundCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormHeroButton}"
                                Margin="0,0,0,6"
                                Padding="14,8">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoClean}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Очистить все фоновые" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding RefreshProcessesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormSecondaryButton}"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Обновить список" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search, Filters & Sorters (Clean Non-Overlapping Layout) -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input (Optimized Compact Width) -->
                    <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                        <Grid>
                            <TextBlock Text="Поиск процесса..."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchQuery, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11.5"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Filter Category Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center">
                        <Button x:Name="BtnFilterAll" Click="BtnFilterAll_Click" Content="Все" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,4,0" FontWeight="Bold" FontSize="11"/>
                        <Button x:Name="BtnFilterSafe" Click="BtnFilterSafe_Click" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,4,0"/>
                                <TextBlock Text="Безопасные" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFilterUser" Click="BtnFilterUser_Click" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,4,0"/>
                                <TextBlock Text="Пользовательские" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnFilterSystem" Click="BtnFilterSystem_Click" Style="{StaticResource StormSecondaryButton}" Padding="10,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,4,0"/>
                                <TextBlock Text="Системные" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sorting Selectors -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Сортировка: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Command="{Binding SetSortCommand}" CommandParameter="ЦП" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,3,0">
                            <TextBlock Text="🔥 ЦП" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding SetSortCommand}" CommandParameter="Память" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,3,0">
                            <TextBlock Text="🧠 ОЗУ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding SetSortCommand}" CommandParameter="Имя" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,3,0">
                            <TextBlock Text="🔤 Имя" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding SetSortCommand}" CommandParameter="PID" Style="{StaticResource StormSecondaryButton}" Padding="8,4">
                            <TextBlock Text="⚡ PID" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Comparative Impact Bar & Selected Process Bar -->
            <StackPanel Grid.Row="2">
                <ctrl:ComparativeImpactControl Icon="🧠" MetricTitle="Свободно оперативной памяти" MetricSubtitle="Сжатие Standby и выгрузка мусорных фоновых процессов" BeforeValue="3.2 ГБ" AfterValue="7.8 ГБ" BadgeText="+4.6 ГБ ОЗУ" Margin="0,0,0,8"/>

                <!-- Selected Process Action Bar -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8"
                        Visibility="{Binding SelectedProcess, Converter={x:Null}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Выбран: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedProcess.ProcessName}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedProcess.ProcessId, StringFormat=' (PID: {0})'}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding TerminateProcessTreeCommand}" Style="{StaticResource StormDangerButton}" Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="Дерево процессов" FontSize="10.5" FontWeight="Bold"/>
                            </Button>
                            <Button Command="{Binding SuspendSelectedProcessCommand}" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="Заморозить" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B"/>
                            </Button>
                            <Button Command="{Binding ResumeSelectedProcessCommand}" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="Возобновить" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                            </Button>
                            <Button Command="{Binding SetHighPriorityCommand}" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="Высокий приоритет" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Command="{Binding OpenFileLocationCommand}" Style="{StaticResource StormSecondaryButton}" Padding="8,4">
                                <TextBlock Text="Папка 📁" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Processes List -->
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
                <ListBox ItemsSource="{Binding FilteredProcesses}"
                         SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Process Name & PID -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="PID: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ProcessId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text=" • Потоков: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding ThreadsCount}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Description & Recommendation -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RecommendationText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Memory Usage -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FormattedMemory}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Память" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </Border>

                                    <!-- Quick Action Buttons -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnEndProcess_Click"
                                                IsEnabled="{Binding CanBeTerminated}"
                                                Content="Завершить"
                                                Style="{StaticResource StormDangerButton}"
                                                Padding="10,5"
                                                Margin="0,0,4,0"/>

                                        <Button Click="BtnOpenFile_Click"
                                                ToolTip="Открыть расположение файла"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="6,5">
                                            <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы по Менеджеру процессов (FAQ)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoFan}" Fill="{StaticResource IconGradSky}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Что делает функция «Заморозить процесс»?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Заморозка (Suspend) мгновенно приостанавливает выполнение всех потоков процесса через системные вызовы ядра. Процесс перестает нагружать процессор (0% CPU), но сохраняет состояние в памяти и размораживается в любой момент без потери данных." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoShield}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Как работает фильтр «Безопасные»?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Алгоритм STORM сопоставляет процессы с базой доверенных системных служб Windows. Фильтр скрывает критические процессы (csrss, winlogon, dwm, svchost) и оставляет только второстепенные программы и фоновые апдейтеры, которые можно безопасно снять." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Чем отличается завершение дерева процессов?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Обычное завершение убивает только главный процесс, оставляя фоновые дочерние процессы висеть в памяти. Завершение дерева рекурсивно закрывает все связанные процессы и службы приложения." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
