<Page x:Class="StormSystemOptimizer.Views.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Services">

    <Page.DataContext>
        <vm:ServicesViewModel/>
    </Page.DataContext>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A34D399" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoServices}" Fill="{StaticResource IconGradEmerald}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Оптимизация служб Windows" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Настройка фоновых системных служб. Отключение неиспользуемых сервисов снижает фоновую нагрузку на процессор и память."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Top Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ApplyServicesChangesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormHeroButton}"
                                Padding="16,10"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#33FFFFFF" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoDisks}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Применить настройки" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RefreshServicesCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource StormSecondaryButton}"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A00D2FF" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Обновить" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Optimization Profile Presets with active highlights -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Профили быстрой конфигурации" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Применение предварительно настроенных безопасных конфигураций служб в один клик." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Recommended -->
                        <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Recommended"
                                Style="{StaticResource StormSecondaryButton}"
                                Margin="0,0,8,0"
                                Padding="12,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A10B981" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoShield}" Fill="#10B981" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Рекомендуемый" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Gaming -->
                        <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Gaming"
                                Style="{StaticResource StormSecondaryButton}"
                                Margin="0,0,8,0"
                                Padding="12,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AC084FC" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Игровой" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Extreme -->
                        <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Extreme"
                                Style="{StaticResource StormSecondaryButton}"
                                Margin="0,0,8,0"
                                Padding="12,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1AFBBF24" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradAmber}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Экстремальный" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Default / Reset -->
                        <Button Command="{Binding ApplyPresetCommand}" CommandParameter="Default"
                                Style="{StaticResource StormSecondaryButton}"
                                Padding="12,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A00D2FF" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="По умолчанию" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Services List with Dynamic Live Status Color Badges -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <ListBox ItemsSource="{Binding Services}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Service Title & Description -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ServiceName, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Live Status Badge with high-contrast distinct background and text -->
                                    <Border Grid.Column="1" Background="{Binding StatusBgColor}" BorderBrush="{Binding StatusColor}" BorderThickness="1.5" CornerRadius="6" Padding="10,5" Margin="0,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Статус: " FontSize="10" Foreground="{Binding StatusColor}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Dynamic Optimization Toggle CheckBox (Оптимизирована / По умолчанию) -->
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsOptimized, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Content="{Binding OptimizationStateText}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</Page>
