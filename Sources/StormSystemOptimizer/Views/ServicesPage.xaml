<Page
    x:Class="StormSystemOptimizer.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StormSystemOptimizer.Views"
    xmlns:models="using:StormSystemOptimizer.Models"
    xmlns:vm="using:StormSystemOptimizer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{ThemeResource StormCardGradient}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                        <TextBlock Text="Оптимизация служб Windows и телеметрии" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Безопасное отключение скрытых телеметрических и фоновых служб для разгрузки процессора." FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{ThemeResource BadgeSafeBgBrush}" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="100% ОБРАТИМО" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource BadgeSafeTextBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Presets Row -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Готовые профили:" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Click="BtnPresetBalanced_Click" Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⚖️ Сбалансированный" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button Click="BtnPresetGaming_Click" Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🎮 Игровой режим" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button Click="BtnPresetExtreme_Click" Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⚡ Экстремальный" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>

                <Button Click="BtnPresetDefault_Click" Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🔄 Стандартный Windows" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Services List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ServicesList, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ServiceEntry">
                    <Border Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <Border Background="{ThemeResource CardHoverBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind ServiceName}" FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Column="1" Background="{ThemeResource CardHoverBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="12,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Состояние:" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Toggle Action Button -->
                            <Button Grid.Column="2" Click="BtnToggleService_Click" DataContext="{x:Bind}"
                                    Background="{ThemeResource CardHoverBrush}" BorderBrush="{ThemeResource CardBorderBrush}" CornerRadius="6" Padding="12,6">
                                <TextBlock Text="Переключить" FontSize="12" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
