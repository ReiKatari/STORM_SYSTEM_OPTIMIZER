<Page x:Class="StormSystemOptimizer.Views.WallpapersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Обои и экран блокировки">

    <Page.DataContext>
        <vm:WallpapersViewModel/>
    </Page.DataContext>

    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Header Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoBrush}" Fill="{StaticResource IconGradCyan}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Обои рабочего стола и экрана блокировки" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Коллекция 62 ультра-четких 8K и 4K обоев, назначение на отдельные мониторы, полноэкранный предпросмотр, фильтрация по категориям и разрешениям, отключение экрана блокировки и живые луп-обои WorkerW."
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding BrowseCustomWallpaperCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,8,0">
                                <TextBlock Text="Свои обои..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Multi-Monitor Target Selector Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoMonitor}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Выбор целевого экрана (монитора) для обоев" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Выберите конкретный монитор для индивидуальной установки обоев либо синхронную установку на все подключенные экраны."
                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="DisplayName" MinWidth="270" Height="36" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Lock Screen Controls Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Настройки экрана блокировки Windows" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Отключить экран блокировки (вход напрямую на рабочий стол)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Пропускает дополнительный экран блокировки с часами и сразу отображает рабочий стол или ввод пароля." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsNoLockScreen}" Command="{Binding ToggleNoLockScreenCommand}" Content="Отключить экран" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Отключить советы, рекламу и факты на экране блокировки" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Удаляет навязчивые подсказки Edge, факты дня и рекламные баннеры Bing с экрана блокировки." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsLockScreenTipsDisabled}" Command="{Binding ToggleLockScreenTipsCommand}" Content="Отключить советы" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WorkerW Live Wallpaper Engine Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Движок живых обоев WorkerW" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Внедрение видео и аппаратных шейдеров непосредственно под значки рабочего стола с минимальной нагрузкой на видеокарту." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <TextBox Text="{Binding LiveVideoPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <Button Grid.Column="1" Command="{Binding BrowseLiveVideoCommand}" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,0,8,0">
                                <TextBlock Text="Выбрать видео..." FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding StartLiveWallpaperCommand}" Style="{StaticResource StormHeroButton}" Padding="16,8">
                                <TextBlock Text="Запустить WorkerW" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Filters Card (Categories & Resolutions) -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Categories -->
                        <DockPanel Margin="0,0,0,10" LastChildFill="True">
                            <TextBlock Text="Категория:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" Width="85" DockPanel.Dock="Left"/>
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.FilterCategoryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="12,6" Margin="0,0,6,4"
                                                FontSize="11.5" FontWeight="Bold"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Resolutions -->
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="Разрешение:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" Width="85" DockPanel.Dock="Left"/>
                            <ItemsControl ItemsSource="{Binding Resolutions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.FilterResolutionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                Style="{StaticResource StormSecondaryButton}"
                                                Padding="12,6" Margin="0,0,6,4"
                                                FontSize="11.5" FontWeight="Bold"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Wallpapers Grid -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Каталог 62 премиальных ультра-обоев (8K, 4K, QHD, FHD и Живые лупы)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding FilteredWallpapers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="6">
                                        <StackPanel>
                                            <!-- Wallpaper Image Preview (Clickable for zoom) -->
                                            <Button Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10"
                                                    ToolTip="Нажмите для увеличения и полноэкранного предпросмотра">
                                                <Border CornerRadius="8" Height="150" ClipToBounds="True" Background="#0A0B10">
                                                    <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                            </Button>

                                            <!-- Title & Category -->
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Resolution}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Border Grid.Column="1" Background="#1A00D2FF" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StormSecondaryButton}"
                                                        Padding="10,6" ToolTip="Открыть полноэкранный предпросмотр и увеличение">
                                                    <TextBlock Text="🔍 Превью" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.ApplyDesktopWallpaperCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StormHeroButton}"
                                                        Padding="8,6">
                                                    <TextBlock Text="Рабочий стол" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Button>
                                                <Button Grid.Column="4"
                                                        Command="{Binding DataContext.ApplyLockScreenWallpaperCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StormSecondaryButton}"
                                                        Padding="10,6">
                                                    <TextBlock Text="Блокировка" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Status Banner -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <TextBlock Text="{Binding StatusMessage, StringFormat='💡 Статус: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Lightbox Zoom Modal Overlay -->
        <Grid Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#E60A0B10" Panel.ZIndex="100">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}"
                    BorderThickness="1.5" CornerRadius="16" Margin="40" MaxWidth="1100" MaxHeight="820"
                    Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.45"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewWallpaper.Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#1A00D2FF" CornerRadius="6" Padding="8,4" Margin="14,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PreviewWallpaper.Resolution}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                            <Border Background="#1A10B981" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PreviewWallpaper.Category}" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding ClosePreviewCommand}" Style="{StaticResource StormSecondaryButton}" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="✕ Закрыть" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Preview High-Res Image Container -->
                    <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Background="#06070A" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" MinHeight="360" MaxHeight="520">
                        <Image Source="{Binding PreviewWallpaper.PreviewUrl}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Modal Bottom Bar: Monitor Selector & Actions -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Monitor Selector -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Целевой экран:" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="DisplayName" MinWidth="240" Height="36" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ApplyDesktopWallpaperCommand}" CommandParameter="{Binding PreviewWallpaper}" Style="{StaticResource StormHeroButton}" Padding="16,10" Margin="0,0,10,0">
                                <TextBlock Text="🖼️ Установить на рабочий стол" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                            <Button Command="{Binding ApplyLockScreenWallpaperCommand}" CommandParameter="{Binding PreviewWallpaper}" Style="{StaticResource StormSecondaryButton}" Padding="14,10" Margin="0,0,10,0">
                                <TextBlock Text="🔒 На экран блокировки" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                            <Button Command="{Binding DownloadWallpaperCommand}" CommandParameter="{Binding PreviewWallpaper}" Style="{StaticResource StormSecondaryButton}" Padding="14,10">
                                <TextBlock Text="💾 Сохранить оригинал" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
