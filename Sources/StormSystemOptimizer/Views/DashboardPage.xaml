<Page x:Class="StormSystemOptimizer.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StormSystemOptimizer.Views"
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      Title="Dashboard">

    <Page.DataContext>
        <vm:DashboardViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Hero Banner / Quick Boost Card -->
            <Border Background="{DynamicResource StormCardGradient}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="28"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="СИСТЕМНЫЙ МОНИТОР" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                            <Border Background="{DynamicResource BadgeSafeBgBrush}" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="100% БЕЗОПАСНЫЙ РЕЖИМ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BadgeSafeTextBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Производительность и Здоровье ПК" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Мгновенное освобождение оперативной памяти, сброс сетевого кэша и оптимизация фоновых процессов без закрытия приложений."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="620" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding QuickStormBoostCommand}"
                                    IsEnabled="{Binding IsNotOptimizing}"
                                    Background="{DynamicResource StormHeroGradient}"
                                    Foreground="#FFFFFF"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Padding="24,12"
                                    Margin="0,0,16,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="16"/>
                                    <TextBlock Text="{Binding OptimizeButtonText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Storm Shield Emblem & Health Score -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,0,0">
                        <Border Width="110" Height="110" CornerRadius="55" Background="{DynamicResource AccentGlowBrush}"
                                BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HealthScore}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="БАЛЛОВ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding HealthStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Real-Time Hardware Diagnostics Grid -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="ПРОЦЕССОР (CPU)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource AccentGlowBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding CpuTemperatureText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding CpuUsage}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Height="6" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CpuName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="1" Margin="5,0,5,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="ПАМЯТЬ (RAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="💾" FontSize="14" Foreground="{DynamicResource AccentSecondaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding RamUsage}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding RamUsage}" Maximum="100" Height="6" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding RamDetails}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Grid.Column="2" Margin="5,0,5,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="СИСТЕМНЫЙ ДИСК" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource AccentGlowBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding DiskTemperatureText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DiskUsage, StringFormat={}{0:F0}}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding DiskUsage}" Maximum="100" Height="6" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DiskDetails}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- System Info Card -->
                <Border Grid.Column="3" Margin="10,0,0,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="ИНФО СИСТЕМЫ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="🖥" FontSize="14" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding OsVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding GpuName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Аптайм: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding UptimeString}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Action Cards Section -->
            <TextBlock Text="Быстрые действия оптимизации" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Click="BtnDnsFlush_Click" Grid.Column="0" Margin="0,0,10,0" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                                            <TextBlock Text="🌐" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="Сброс кэша DNS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Устраняет задержки сети и сетевые ошибки при открытии веб-ресурсов." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="BtnTrimSsd_Click" Grid.Column="1" Margin="5,0,5,0" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                                            <TextBlock Text="🖴" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="Оптимизация SSD (TRIM)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Очищает неиспользуемые блоки на SSD диске для поддержки максимальной скорости записи." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="BtnPowerPlan_Click" Grid.Column="2" Margin="10,0,0,0" Cursor="Hand" Background="{DynamicResource CardBackgroundBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="6" Padding="8" Margin="0,0,10,0">
                                            <TextBlock Text="⚡" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="Макс. Производительность" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Включает режим Ultimate Performance питания для максимального FPS и скорости." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
