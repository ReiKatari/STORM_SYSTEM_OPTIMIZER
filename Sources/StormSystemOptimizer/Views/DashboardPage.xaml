<Page x:Class="StormSystemOptimizer.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      xmlns:ctrl="clr-namespace:StormSystemOptimizer.Controls"
      Title="Панель состояния">

    <Page.DataContext>
        <vm:DashboardViewModel x:Name="ViewModel"/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <!-- Hero Status Banner with Radial STORM INDEX Gauge -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Circular STORM INDEX Speedometer -->
                    <ctrl:CircularGaugeControl Grid.Column="0"
                                              Value="{Binding HealthScore}"
                                              Maximum="100"
                                              Unit="PTS"
                                              Title="STORM INDEX"
                                              ArcBrush="{StaticResource IconGradCyan}"
                                              StrokeThickness="9"
                                              Margin="0,0,20,0"
                                              VerticalAlignment="Center"/>

                    <!-- Hero Text -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                                <TextBlock Text="⚡ СИСТЕМА ГОТОВА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                            <Border Background="#1A10B981" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding HealthStatusText}" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Компьютер готов к максимальной производительности"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Комплексный мониторинг ресурсов, сжатие памяти ядра, калибровка частоты таймера и оптимизация задержек."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Quick Optimize RAM Button -->
                    <Button Click="BtnOptimizeMemory_Click"
                            Grid.Column="2"
                            Style="{StaticResource StormHeroButton}"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Padding="20,14">
                        <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="4" Padding="4" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoRam}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding OptimizeButtonText, FallbackValue='⚡ Очистить память (ОЗУ)'}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- STORM GAME BOOST & Low Latency Control Hub -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="14" Padding="18" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Игровой турбо-режим и Ultra-Low Latency" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="#1AFB7185" BorderBrush="#33FB7185" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameBoostStatusText}" FontSize="11" FontWeight="Bold" Foreground="#FB7185"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="Автоматический фокус CPU (P-Cores), высокоточный таймер 0.500 мс (NtSetTimerResolution), изоляция фоновых служб и минимизация задержек ввода."
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding TimerResolutionText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Game Boost Control Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleGameBoostCommand}"
                                Style="{StaticResource StormHeroButton}"
                                Margin="0,0,8,0"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoStartup}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="⚡ ИГРОВОЙ РЕЖИМ" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleTimerResolutionCommand}"
                                Style="{StaticResource StormSecondaryButton}"
                                Margin="0,0,8,0"
                                Padding="12,10">
                            <TextBlock Text="⏱️ Таймер 0.5 мс" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>

                        <Button Command="{Binding ToggleOverlayCommand}"
                                Style="{StaticResource StormSecondaryButton}"
                                Margin="0,0,8,0"
                                Padding="12,10">
                            <TextBlock Text="📊 ОВЕРЛЕЙ HUD" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Telemetry & Gaming Performance Bar: DPC Latency, Game Ping & Power Plan -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. DPC Latency -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Задержка DPC (Ядро)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding DpcLatencyText}" FontSize="12" FontWeight="Bold" Foreground="{Binding DpcLatencyColor}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. Game Pings -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Padding="5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Игровой пинг" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding GamePingsSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 3. Power Plan Quick Switch -->
                    <Button Grid.Column="2" Command="{Binding TogglePowerPlanCommand}" Style="{StaticResource StormSecondaryButton}" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoPower}" Fill="{StaticResource IconGradAmber}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ActivePowerPlanText, StringFormat='{}План: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Radial Speedometer Gauges & Live Waveform Grid -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card with Circular Gauge & Sparkline -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoCpu}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="ПРОЦЕССОР" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding CpuTemperatureText}" FontSize="11.5" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right"/>
                        </Grid>

                        <ctrl:CircularGaugeControl Value="{Binding CpuUsage}" Maximum="100" Unit="%" Title="ЦП" ArcBrush="{StaticResource IconGradCyan}" Margin="0,4"/>
                        <ctrl:SparklineControl DataPoints="{Binding CpuHistory}" StrokeBrush="{StaticResource IconGradCyan}" FillBrush="#2600D2FF" Height="28" Margin="0,6,0,6"/>
                        <TextBlock Text="{Binding CpuName}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- RAM Card with Circular Gauge & Sparkline -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="3,0,3,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AC084FC" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoRam}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="ПАМЯТЬ RAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding RamDetails}" FontSize="11" FontWeight="SemiBold" Foreground="#C084FC" HorizontalAlignment="Right"/>
                        </Grid>

                        <ctrl:CircularGaugeControl Value="{Binding RamUsage}" Maximum="100" Unit="%" Title="ОЗУ" ArcBrush="{StaticResource IconGradPurple}" Margin="0,4"/>
                        <ctrl:SparklineControl DataPoints="{Binding RamHistory}" StrokeBrush="{StaticResource IconGradPurple}" FillBrush="#26C084FC" Height="28" Margin="0,6,0,6"/>
                        <TextBlock Text="Сжатие Standby активно" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- GPU Card with Circular Gauge -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="3,0,3,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AFB7185" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoGpu}" Fill="{StaticResource IconGradRose}" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="ВИДЕОКАРТА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding GpuTemperatureText}" FontSize="11.5" FontWeight="Bold" Foreground="#FB7185" HorizontalAlignment="Right"/>
                        </Grid>

                        <ctrl:CircularGaugeControl Value="{Binding GpuTemperatureValue}" Maximum="100" Unit="°C" Title="GPU" ArcBrush="{StaticResource IconGradRose}" Margin="0,4"/>
                        <ctrl:SparklineControl DataPoints="{Binding NetHistory}" StrokeBrush="{StaticResource IconGradRose}" FillBrush="#26FB7185" Height="28" Margin="0,6,0,6"/>
                        <TextBlock Text="{Binding GpuName}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Disk C: Card -->
                <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A34D399" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="ДИСК С:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding DiskTemperatureText}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                        </Grid>

                        <ctrl:CircularGaugeControl Value="{Binding DiskUsage}" Maximum="100" Unit="%" Title="ДИСК" ArcBrush="{StaticResource IconGradEmerald}" Margin="0,4"/>
                        <ctrl:SparklineControl DataPoints="{Binding NetHistory}" StrokeBrush="{StaticResource IconGradEmerald}" FillBrush="#2634D399" Height="28" Margin="0,6,0,6"/>
                        <TextBlock Text="{Binding SystemDiskFreeText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Action Tiles -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Action 1: Deep Clean -->
                <Button Click="BtnDeepScan_Click" Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource StormSecondaryButton}" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="10" Width="40" Height="40" Margin="0,0,0,8" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Глубокая очистка" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Кэш, дампы, шейдеры" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Action 2: DNS Flush -->
                <Button Click="BtnFlushDns_Click" Grid.Column="1" Margin="3,0,3,0" Style="{StaticResource StormSecondaryButton}" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="10" Width="40" Height="40" Margin="0,0,0,8" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Сброс кэша DNS" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Устранение сетевых задержек" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Action 3: Power Plan -->
                <Button Click="BtnMaxPerformance_Click" Grid.Column="2" Margin="3,0,3,0" Style="{StaticResource StormSecondaryButton}" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#1AFBBF24" BorderBrush="#33FBBF24" BorderThickness="1" CornerRadius="10" Width="40" Height="40" Margin="0,0,0,8" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradAmber}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Макс. производительность" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Схема электропитания" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Action 4: TRIM SSD -->
                <Button Click="BtnTrimSsd_Click" Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource StormSecondaryButton}" Padding="14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#1AC084FC" BorderBrush="#33C084FC" BorderThickness="1" CornerRadius="10" Width="40" Height="40" Margin="0,0,0,8" HorizontalAlignment="Center">
                            <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradPurple}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Оптимизация SSD" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Команда TRIM на все диски" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- System Readiness & Latency Status Indicators -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Indicator 1: DirectStorage -->
                    <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1A00D2FF" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="DirectStorage" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DirectStorageStatus}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Indicator 2: ReBAR -->
                    <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1AC084FC" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoGpu}" Fill="{StaticResource IconGradPurple}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Resizable BAR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RebarStatus}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Indicator 3: VBS / Core Isolation -->
                    <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1AFB7185" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoDefender}" Fill="{StaticResource IconGradRose}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Изоляция ядер" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CoreIsolationStatus}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Indicator 4: MMCSS / High-Res Timer -->
                    <Border Grid.Column="3" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1AFBBF24" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoTimer}" Fill="{StaticResource IconGradAmber}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Аудио и MMCSS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MmcssStatus}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Hardware Specification Box -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoProcesses}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Спецификация аппаратного обеспечения" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                            <TextBlock Text="Процессор" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CpuName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,8">
                            <TextBlock Text="Графический ускоритель" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding GpuName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,10,0">
                            <TextBlock Text="Материнская плата / BIOS" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MotherboardName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,8,0,0">
                            <TextBlock Text="Имя компьютера / Пользователь" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ComputerName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,16,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы и ответы (FAQ)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoDashboard}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Что показывает STORM INDEX и круговые спидометры?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="STORM INDEX — это интегральный показатель оптимизации Windows от 0 до 100 баллов, учитывающий свободную память, кэши, фоновые нагрузки и отклик накопителей. Круговые спидометры в реальном времени отображают загрузку и температуру компонентов." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoGame}" Fill="{StaticResource IconGradPurple}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Как включить STORM HUD в играх и какая у меня герцовка?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Нажмите кнопку «STORM HUD» в шапке или используйте горячие клавиши Ctrl+Shift+O. Оверлей отображается поверх всех игр и показывает реальную физическую частоту экрана (Гц), температуры и FPS." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoShield}" Fill="{StaticResource IconGradEmerald}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Безопасна ли очистка памяти ядра?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Да, очистка кэша Standby и сжатие памяти используют официальные API ядра Windows (EmptyWorkingSet), освобождая ОЗУ без закрытия открытых документов и программ." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Что делает калибровка таймера 0.500 мс?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Стандартный квант таймера планировщика Windows равен 15.6 мс или 1.0 мс. Установка таймера в 0.500 мс (High Resolution Timer) удваивает частоту опроса мыши, клавиатуры и игрового цикла D3D, устраняя микрофризы и снижая задержку ввода." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSpeedTest}" Fill="{StaticResource IconGradSky}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Что показывают волновые графики под спидометрами?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Это графики Bezier Sparklines в реальном времени, отражающие динамику активности за последние 30-45 секунд. Они позволяют моментально выявлять внезапные всплески фоновой нагрузки." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
