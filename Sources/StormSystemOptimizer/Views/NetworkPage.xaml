<Page x:Class="StormSystemOptimizer.Views.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StormSystemOptimizer.ViewModels"
      xmlns:ctrl="clr-namespace:StormSystemOptimizer.Controls"
      Title="Network">

    <Page.DataContext>
        <vm:NetworkViewModel/>
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Header -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Глубокая оптимизация и ускорение интернета" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Диагностика сетевого адаптера, определение внешнего IP и провайдера, встроенный замер скорости соединения, оптимизация TCP/IP, DNS-бенчмарк и сетевой экран Blackhole Shield."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding DnsStatus}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Command="{Binding LoadNetworkDataCommand}"
                            Grid.Column="1"
                            Style="{StaticResource StormSecondaryButton}"
                            VerticalAlignment="Center"
                            Padding="14,10">
                        <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoScanner}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Обновить сеть" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Comparative Impact Banner -->
            <ctrl:ComparativeImpactControl Icon="🌐" MetricTitle="Сетевая задержка (Ping в играх)" MetricSubtitle="Применение Comss / Fast Gaming DNS и TCP NoDelay" BeforeValue="68 мс" AfterValue="24 мс" BadgeText="-44 мс пинг" Margin="0,0,0,16"/>

            <!-- Current DNS Display Banner -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="#1A00D2FF" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                            <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Текущий DNS в системе: " FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding NetworkInfo.DnsServers}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveDnsProvider, StringFormat='(Профиль: {0})'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Network Diagnostics & Live Telemetry Grid -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Информация о сетевом соединении и провайдере" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- External IP -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Внешний IP" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding NetworkInfo.ExternalIp}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding NetworkInfo.Location}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ISP / Provider -->
                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Интернет-провайдер" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding NetworkInfo.IspName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="Широкополосная сеть" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Local IP & Adapter -->
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Локальный IP / Шлюз" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding NetworkInfo.LocalIp}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding NetworkInfo.GatewayIp, StringFormat='Шлюз: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Ping & Speed -->
                <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Задержка Ping / Линк" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PingText}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding NetworkInfo.LinkSpeed}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Built-in Speed Test Card -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoSpeedTest}" Fill="{StaticResource IconGradCyan}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Встроенный тест скорости интернета" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SpeedStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Command="{Binding RunSpeedTestCommand}"
                                Grid.Column="1"
                                Style="{StaticResource StormHeroButton}"
                                Padding="16,10">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="4" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoStartup}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Запустить тест скорости" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Speed Test Results Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Download -->
                        <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Скорость загрузки" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SpeedTest.DownloadMbps, StringFormat='{}{0:F1}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text=" Мбит/с" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Upload -->
                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Скорость отдачи" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SpeedTest.UploadMbps, StringFormat='{}{0:F1}'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}"/>
                                    <TextBlock Text=" Мбит/с" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ping -->
                        <Border Grid.Column="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Задержка Ping" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SpeedTest.PingMs}" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock Text=" мс" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quality with TextWrapping -->
                        <Border Grid.Column="3" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Качество связи" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SpeedTest.QualityRating}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ProgressBar Value="{Binding SpeedProgress}" Maximum="100" Height="6" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Network Accelerators & Reset Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TCP NoDelay -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoStartup}" Fill="{StaticResource IconGradCyan}" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="TCP NoDelay (Алгоритм Нагла)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Мгновенная отправка пакетов без задержки (TcpAckFrequency=1) для онлайн-игр." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Command="{Binding ToggleTcpNoDelayCommand}" Grid.Column="1" Style="{StaticResource StormHeroButton}" Content="Оптимизировать" Padding="12,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Blackhole Shield -->
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1AFB7185" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoPrivacy}" Fill="{StaticResource IconGradRose}" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Сетевой экран Blackhole Shield" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Блокировка серверов телеметрии и рекламы на уровне сетевых маршрутов." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Command="{Binding ToggleBlackholeShieldCommand}" Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Content="Вкл / Выкл" Padding="12,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- MTU Auto-Tuner -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1A34D399" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoDisks}" Fill="{StaticResource IconGradEmerald}" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Авто-тюнинг MTU (1500 байт)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Оптимизация максимального размера пакета MTU для исключения фрагментации." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Command="{Binding OptimizeMtuCommand}" Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Content="Настроить" Padding="12,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Reset Network Stack -->
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1AFBBF24" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                                    <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradAmber}" Width="11" Height="11" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="Полный сброс сети и Winsock" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Восстановление каталога Winsock, стека TCP/IP и сброс сетевых сбоев." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Command="{Binding ResetNetworkStackCommand}" Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Content="Сброс сети" Padding="12,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Custom DNS Configurator (DNS 1 & DNS 2) -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#1A00D2FF" CornerRadius="4" Padding="3" Margin="0,0,6,0">
                                <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource IconGradCyan}" Width="12" Height="12" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Пользовательский DNS (Ручной ввод DNS 1 и DNS 2)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Укажите любые произвольные адреса DNS-серверов для назначения активному сетевому адаптеру." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- DNS 1 Field -->
                        <Border Grid.Column="0" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Основной DNS 1 (IPv4)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CustomDnsPrimary, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- DNS 2 Field -->
                        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Альтернативный DNS 2 (IPv4)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding CustomDnsSecondary, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Apply Custom DNS Button -->
                        <Button Grid.Column="2" Command="{Binding ApplyCustomDnsCommand}" Style="{StaticResource StormHeroButton}" Padding="16,8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="3" Padding="2" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoDashboard}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Применить свой DNS" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Reset to DHCP Button -->
                        <Button Grid.Column="3" Click="BtnDnsDhcp_Click" Style="{StaticResource StormSecondaryButton}" Padding="12,8" VerticalAlignment="Center">
                            <TextBlock Text="Вернуть DHCP" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Smart DNS Benchmark Table & 1-Click Switcher -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Тест задержки DNS-серверов и переключение в 1 клик" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Замер пинга до глобальных серверов сопоставления доменов и назначение активному сетевому адаптеру." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Command="{Binding BenchmarkDnsCommand}" Grid.Column="1" Style="{StaticResource StormHeroButton}" Padding="16,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoScanner}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Тестировать DNS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- DNS List ItemsControl -->
                    <ItemsControl ItemsSource="{Binding DnsServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProviderName}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="✓ ТЕКУЩИЙ DNS В СИСТЕМЕ" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Features}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding DnsIpsText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#1A00D2FF" CornerRadius="6" Padding="10,4" Margin="14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PingText}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                        </Border>

                                        <!-- If active, show Active Badge; otherwise show Install Button -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Border Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}"
                                                    Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                                <TextBlock Text="✓ Активен" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>

                                            <Button Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisConverter}}"
                                                    Command="{Binding DataContext.ApplyDnsItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource StormSecondaryButton}"
                                                    Content="⚡ Установить"
                                                    Padding="14,6"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- DNS Flush Button -->
                    <Button Command="{Binding FlushDnsCommand}" HorizontalAlignment="Left" Style="{StaticResource StormSecondaryButton}" Padding="14,8" Margin="0,6,0,0">
                        <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A00D2FF" CornerRadius="3" Padding="3" Margin="0,2,6,0" VerticalAlignment="Top">
                                    <Path Data="{StaticResource GeoClean}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Очистить кэш DNS (Flush)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- FAQ Section with Gradient Vector Icons -->
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#1A00D2FF" BorderBrush="#3300D2FF" BorderThickness="1" CornerRadius="4" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoQuestion}" Fill="{StaticResource IconGradCyan}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Частые вопросы по Ускорению сети и DNS (FAQ)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoNetwork}" Fill="{StaticResource IconGradSky}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Зачем переключать DNS на Comss.one, Cloudflare или Яндекс?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Стандартный DNS провайдера часто перегружен, медленно сопоставляет домены и блокирует зарубежные игровые сервисы (Xbox, Steam, Discord, Epic Games). Comss.one и Cloudflare мгновенно резолвят адреса и снижают игровой сетевой пинг." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>

                    <Expander Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoLightning}" Fill="{StaticResource IconGradAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Как TCP NoDelay убирает задержку пакетов?" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBlock Text="Алгоритм Нагла по умолчанию задерживает мелкие сетевые пакеты, накапливая их в буфере. Включение TCP NoDelay (TcpAckFrequency=1) принуждает сетевой стек отправлять каждый пакет мгновенно, снижая сетевой инпутлаг в шутерах." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,2,0,2" TextWrapping="Wrap"/>
                    </Expander>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
