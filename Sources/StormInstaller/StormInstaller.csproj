<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\Files\AppIcon.ico</ApplicationIcon>
    <Version>0.3.4</Version>
    <AssemblyVersion>0.3.4.0</AssemblyVersion>
    <FileVersion>0.3.4.0</FileVersion>
    <Product>STORM SYSTEM OPTIMIZER Setup</Product>
    <Company>STORM Software</Company>
    <Description>Установщик официального релиза STORM SYSTEM OPTIMIZER</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Assembling\StormSystemOptimizer.exe" Link="Payload\StormSystemOptimizer.exe" />
    <EmbeddedResource Include="..\..\Files\STORM_Certificate.cer" Link="Payload\STORM_Certificate.cer" />
    <EmbeddedResource Include="..\..\Files\AppIcon.ico" Link="Payload\AppIcon.ico" />
  </ItemGroup>

</Project>
