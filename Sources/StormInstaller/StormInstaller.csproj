<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\Files\AppIcon.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <AssemblyTitle>STORM SYSTEM OPTIMIZER 1.1.2</AssemblyTitle>
    <Product>STORM SYSTEM OPTIMIZER 1.1.2</Product>
    <Title>STORM SYSTEM OPTIMIZER 1.1.2</Title>
    <Description>STORM SYSTEM OPTIMIZER 1.1.2</Description>
    <Company>STORM TEAM</Company>
    <Authors>STORM TEAM</Authors>
    <Copyright>Copyright © 2026 STORM TEAM</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\StormSystemOptimizer\bin\Release\net8.0-windows\win-x64\publish\StormSystemOptimizer.exe" Link="Payload\StormSystemOptimizer.exe" />
    <EmbeddedResource Include="..\StormLauncher\bin\Release\net8.0-windows\win-x64\publish\StormLauncher.exe" Link="Payload\StormLauncher.exe" Condition="Exists('..\StormLauncher\bin\Release\net8.0-windows\win-x64\publish\StormLauncher.exe')" />
    <EmbeddedResource Include="..\..\Files\STORM_Certificate.cer" Link="Payload\STORM_Certificate.cer" />
    <EmbeddedResource Include="..\..\Files\AppIcon.ico" Link="Payload\AppIcon.ico" />
    <EmbeddedResource Include="..\..\Files\logo.png" Link="Payload\logo.png" Condition="Exists('..\..\Files\logo.png')" />
  </ItemGroup>

</Project>
